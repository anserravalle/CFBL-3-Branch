<header class="page-head {% if section.settings.image %}wrap{% else %}measure{% endif %}">
  {%- if section.settings.eyebrow != blank %}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{% endif -%}
  <h1>{{ page.title }}</h1>
  {%- if section.settings.lede != blank %}<p class="lede">{{ section.settings.lede }}</p>{% endif -%}
</header>
{%- if section.settings.image -%}
  <div class="split wrap">
    <figure class="split__img">{{ section.settings.image | image_url: width: 1200 | image_tag: loading: 'eager', sizes: '(min-width: 860px) 40vw, 100vw' }}</figure>
    <div class="prose">{{ page.content }}</div>
  </div>
{%- else -%}
  <div class="prose measure">{{ page.content }}</div>
{%- endif -%}

{% schema %}
{
  "name": "DRS page",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "textarea", "id": "lede", "label": "Lede" },
    { "type": "image_picker", "id": "image", "label": "Photograph", "info": "Optional. Sits beside the text." }
  ],
  "presets": [{ "name": "DRS page" }]
}
{% endschema %}
