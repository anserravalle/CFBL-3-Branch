  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Small line above the title", "default": "CFBL Institute · A reading series for clinicians" },
    { "type": "textarea", "id": "heading", "label": "Title", "default": "What the Doctor\nIs Reading" },
    { "type": "richtext", "id": "intro", "label": "Introduction", "default": "<p>Not a book club. I have already read these. Each subject gets a shelf and each week gets one book: what it gets right, what to hold loosely, and <em>whether it belongs on your shelf</em>.</p>" },
    { "type": "image_picker", "id": "tree_image", "label": "Shelf decoration (the tree)" },
    { "type": "range", "id": "tree_width", "label": "Decoration width", "min": 120, "max": 520, "step": 10, "unit": "px", "default": 380 },
    { "type": "checkbox", "id": "tree_base", "label": "Add a small wooden base under it", "default": false },
    { "type": "image_picker", "id": "shelf_image", "label": "Shelf background photo", "info": "Shown softened behind the books." },
    { "type": "richtext", "id": "tier_note", "label": "Note under the open book", "default": "<p>Every book is sorted by where its central claim sits: established, emerging, theoretical, or clinical wisdom. Clinical wisdom is not a dismissal. It is often right and simply has not been tested yet.</p>" },
    { "type": "text", "id": "follow_label", "label": "Follow link label", "default": "A new book every Sunday" },
    { "type": "url", "id": "follow_link", "label": "Follow link" },
    { "type": "text", "id": "more_label", "label": "Button label", "default": "See the full library" },
    { "type": "url", "id": "more_link", "label": "Button link", "info": "Use on the home page to send readers to the Institute page." },
    { "type": "header", "content": "The library" },
    { "type": "checkbox", "id": "show_library", "label": "Show the library of past subjects", "default": true },
    { "type": "text", "id": "library_heading", "label": "Library heading", "default": "The library" },
    { "type": "text", "id": "library_note", "label": "Library note", "default": "Every past subject stays on the shelf. Choose one to bring it back down." },
    { "type": "header", "content": "Timing" },
