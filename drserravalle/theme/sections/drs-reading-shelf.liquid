        { "type": "text", "id": "title", "label": "Title", "default": "Book title" },
        { "type": "text", "id": "author", "label": "Author", "default": "Author" },
        { "type": "text", "id": "year", "label": "Year" },
        { "type": "text", "id": "week", "label": "Week number", "info": "Leave blank to count automatically." },
        { "type": "text", "id": "release", "label": "Film goes out on (YYYY-MM-DD)", "default": "2026-11-08", "info": "Before this date the book shows as coming." },
        { "type": "header", "content": "Film" },
        { "type": "video", "id": "video", "label": "Film from Shopify Files" },
        { "type": "text", "id": "video_link", "label": "Or paste the film link", "info": "Used only when no film is chosen above." },
        { "type": "text", "id": "runtime", "label": "Length shown", "info": "For example: 1 min 30 sec" },
        { "type": "image_picker", "id": "card", "label": "Cover card", "info": "Shown before the film plays." },
        { "type": "header", "content": "Notes" },
