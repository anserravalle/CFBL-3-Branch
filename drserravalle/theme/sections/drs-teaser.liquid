<section class="teaser">
  <div class="wrap teaser__grid">
    {%- if section.settings.image -%}
      <figure class="teaser__img">{{ section.settings.image | image_url: width: 1200 | image_tag: loading: 'lazy', sizes: '(min-width: 860px) 40vw, 100vw' }}</figure>
    {%- endif -%}
    <div class="teaser__copy">
      {%- if section.settings.eyebrow != blank %}<p class="teaser__when">{{ section.settings.eyebrow }}</p>{% endif -%}
      <h2>{{ section.settings.heading }}</h2>
      {%- if section.settings.text != blank %}<div class="teaser__text">{{ section.settings.text }}</div>{% endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "DRS teaser",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Photograph" },
    { "type": "text", "id": "eyebrow", "label": "Handwritten line", "default": "Coming summer 2027" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "The workbook" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>A companion to <em>The Stories We Told</em>, on codependency.</p>" }
  ],
  "presets": [{ "name": "DRS teaser" }]
}
{% endschema %}
