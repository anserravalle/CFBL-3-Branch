<!doctype html>
{%- liquid
  # Which internal visual system this page renders in.
  # bridge = Core Dr. Niki (Make It Make Sense, home, about)
  # essays = Books + Essays (essays, the book, MUSA imprint)
  # edu    = Professional Education (Institute programs, Clinical Notes, policies)
  assign sys = 'bridge'
  if blog.handle == 'essays' or article.blog.handle == 'essays'
    assign sys = 'essays'
  elsif blog.handle == 'clinical-notes'
    assign sys = 'edu'
  elsif product
    assign sys = 'edu'
  endif
  if template.suffix contains 'book' or template.suffix contains 'musa' or template.suffix contains 'writing'
    assign sys = 'essays'
  elsif template.suffix contains 'education' or template.suffix contains 'program' or template.suffix contains 'policies'
    assign sys = 'edu'
  endif
  if template.suffix contains 'about' or template.suffix contains 'speaking'
    assign sys = 'bridge'
  endif
-%}
<html lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="google-site-verification" content="G9n3uC-EKHD2qzg32_eGGGsPK3NV5jlTIx_bnc-4EAg">
  <link rel="canonical" href="{{ canonical_url }}">
  {%- liquid
    assign seo_title = page_title
    assign seo_desc = page_description
    if template.name == 'index'
      assign seo_title = 'Dr. Niki Serravalle | Psychologist, Author, Educator'
      if seo_desc == blank
        assign seo_desc = 'Dr. Niki Serravalle is a clinical psychologist, author, and educator. Read Make It Make Sense, her essays, and The Stories We Told, and find training for clinicians.'
      endif
    endif
    assign og_img = nil
    if article.image
      assign og_img = article.image
    elsif page.metafields.custom.og_image
      assign og_img = page.metafields.custom.og_image.value
    elsif product.featured_image
      assign og_img = product.featured_image
    elsif settings.share_image
      assign og_img = settings.share_image
    endif
    assign og_type = 'website'
    if template.name == 'article'
      assign og_type = 'article'
    endif
  -%}
  <title>{{ seo_title }}{% unless seo_title contains 'Serravalle' %} | Dr. Niki Serravalle{% endunless %}</title>
  {%- if seo_desc != blank %}<meta name="description" content="{{ seo_desc | strip_html | truncate: 160 | escape }}">{% endif %}
  <meta property="og:site_name" content="Dr. Niki Serravalle">
  <meta property="og:type" content="{{ og_type }}">
  <meta property="og:url" content="{{ canonical_url }}">
  <meta property="og:title" content="{{ seo_title | escape }}">
  {%- if seo_desc != blank %}<meta property="og:description" content="{{ seo_desc | strip_html | truncate: 200 | escape }}">{% endif %}
  {%- if og_img -%}
    <meta property="og:image" content="https:{{ og_img | image_url: width: 1200 }}">
    <meta name="twitter:card" content="summary_large_image">
  {%- else -%}
    <meta property="og:image" content="https:{{ '20261114_DRS_Niki_headshot_burgundy.png' | file_url }}">
    <meta name="twitter:card" content="summary_large_image">
  {%- endif -%}
  {%- if template.name == 'index' or template.suffix contains 'about' -%}
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "Person",
      "name": "Dr. Niki Serravalle",
      "honorificSuffix": "PsyD, LPCMH, NCC",
      "jobTitle": "Clinical Psychologist",
      "url": "https://drserravalle.com",
      "image": {{ '20261114_DRS_Niki_headshot_burgundy.png' | file_url | prepend: 'https:' | json }},
      "worksFor": { "@type": "Organization", "name": "Center for Balanced Living", "url": "https://balancedlivingde.com" },
      "sameAs": ["https://instagram.com/dr.nikiserravalle", "https://www.facebook.com/Dr.Serravalle", "https://www.linkedin.com/in/dr-niki-serravalle-87103376", "https://tiktok.com/@drserravalle", "https://www.youtube.com/channel/UCajDa-DuAwQm1gnh4Xg1ZZA", "https://linktr.ee/Drserravalle"]
    }
    </script>
  {%- endif -%}
  {%- if template.name == 'index' -%}
    <script type="application/ld+json">
    { "@context": "https://schema.org", "@type": "WebSite", "name": "Dr. Niki Serravalle", "url": "https://drserravalle.com" }
    </script>
  {%- endif -%}
  {%- if template.name == 'article' -%}
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "Article",
      "headline": {{ article.title | json }},
      "datePublished": {{ article.published_at | date: '%Y-%m-%dT%H:%M:%SZ' | json }},
      "dateModified": {{ article.updated_at | date: '%Y-%m-%dT%H:%M:%SZ' | json }},
      "mainEntityOfPage": {{ canonical_url | json }},
      {%- if article.image %}"image": {{ article.image | image_url: width: 1200 | prepend: 'https:' | json }},{% endif %}
      "author": { "@type": "Person", "name": "Dr. Niki Serravalle", "url": "https://drserravalle.com/pages/about" },
      "publisher": { "@type": "Person", "name": "Dr. Niki Serravalle" }
    }
    </script>
  {%- endif -%}
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  {%- case sys -%}
    {%- when 'essays' -%}
      <link href="https://fonts.googleapis.com/css2?family=DM+Serif+Display&family=EB+Garamond:ital,wght@0,400;0,500;1,400&display=swap" rel="stylesheet">
    {%- when 'edu' -%}
      <link href="https://fonts.googleapis.com/css2?family=Cormorant+SC:wght@500;600&family=Lora:ital,wght@0,400;0,500;1,400&family=Inter:wght@400;500&display=swap" rel="stylesheet">
    {%- else -%}
      <link href="https://fonts.googleapis.com/css2?family=Cormorant+SC:wght@500;600&family=Lora:ital,wght@0,400;0,500;1,400&family=Inter:wght@400;500&family=DM+Serif+Display&family=EB+Garamond:ital,wght@0,400;0,500;1,400&family=Allura&display=swap" rel="stylesheet">
  {%- endcase -%}
  {{ 'drs.css' | asset_url | stylesheet_tag }}
  {{ content_for_header }}
</head>
<body class="sys-{{ sys }} tpl-{{ template.name }}{% if template.suffix %} tpl-{{ template.name }}-{{ template.suffix }}{% endif %}">
  <a class="skip" href="#main">Skip to content</a>
  {% section 'drs-header' %}
  <main id="main">
    {{ content_for_layout }}
  </main>
  {% section 'drs-footer' %}
</body>
</html>
