[
  {
    "name": "theme_info",
    "theme_name": "Center for Balanced Living",
    "theme_version": "1.0.0",
    "theme_author": "Center for Balanced Living",
    "theme_documentation_url": "https://code.claude.com/docs",
    "theme_support_url": "https://code.claude.com/docs"
  },
  {
    "name": "Brand colors",
    "settings": [
      {
        "type": "paragraph",
        "content": "Core brand palette. Defaults match the CFBL Brand Kit (Deep Navy, Sky Blue, Sand, Terracotta)."
      },
      { "type": "color", "id": "color_primary", "label": "Primary color (headings, primary buttons)", "default": "#2B5275" },
      { "type": "color", "id": "color_secondary", "label": "Secondary color (links, accents)", "default": "#4E9FBF" },
      { "type": "color", "id": "color_sand", "label": "Sand (warm fields, sand backgrounds)", "default": "#EED9C5" },
      { "type": "color", "id": "color_accent", "label": "Accent color (terracotta, use sparingly)", "default": "#9D654E" },
      { "type": "color", "id": "color_background", "label": "Page background", "default": "#FBF6F0" },
      { "type": "color", "id": "color_text", "label": "Body text color", "default": "#2A2724" }
    ]
  },
  {
    "name": "Typography",
    "settings": [
      { "type": "paragraph", "content": "Brand typefaces are Cormorant SC (headings) and Montserrat (body), loaded by the theme. Turn off the toggle below to pick from Shopify's font library instead." },
      { "type": "checkbox", "id": "use_brand_fonts", "label": "Use brand fonts (Cormorant SC + Montserrat)", "default": true },
      { "type": "font_picker", "id": "heading_font", "label": "Heading font (override)", "default": "cormorant_n4", "info": "Used only when 'Use brand fonts' is off." },
      { "type": "font_picker", "id": "body_font", "label": "Body font (override)", "default": "montserrat_n4", "info": "Used only when 'Use brand fonts' is off." },
      { "type": "range", "id": "base_font_size", "label": "Base font size", "min": 15, "max": 20, "step": 1, "unit": "px", "default": 16 },
      { "type": "range", "id": "heading_scale", "label": "Heading scale", "min": 80, "max": 130, "step": 5, "unit": "%", "default": 100, "info": "Scales all headings up or down together." }
    ]
  },
  {
    "name": "Layout & spacing",
    "settings": [
      { "type": "range", "id": "page_max_width", "label": "Page max width", "min": 1100, "max": 1600, "step": 20, "unit": "px", "default": 1280 },
      { "type": "range", "id": "section_max_width", "label": "Content max width", "min": 900, "max": 1400, "step": 20, "unit": "px", "default": 1100 },
      { "type": "range", "id": "section_spacing", "label": "Global vertical section spacing", "min": 32, "max": 160, "step": 4, "unit": "px", "default": 80, "info": "Default top/bottom padding for sections; each section can override." },
      { "type": "range", "id": "button_radius", "label": "Button corner radius", "min": 0, "max": 999, "step": 1, "unit": "px", "default": 999 },
      { "type": "range", "id": "card_radius", "label": "Card & image corner radius", "min": 0, "max": 40, "step": 1, "unit": "px", "default": 16 }
    ]
  },
  {
    "name": "Header",
    "settings": [
      { "type": "select", "id": "header_style", "label": "Header style", "options": [
        { "value": "light", "label": "Light (warm background)" },
        { "value": "navy", "label": "Navy" }
      ], "default": "light" },
      { "type": "checkbox", "id": "header_sticky", "label": "Sticky header on scroll", "default": true },
      { "type": "image_picker", "id": "logo", "label": "Logo image (CFBL - rainbow tree)" },
      { "type": "range", "id": "logo_height", "label": "Logo height", "min": 24, "max": 96, "step": 2, "unit": "px", "default": 48 },
      { "type": "image_picker", "id": "logo_mobile", "label": "Mobile logo image (optional)" },
      { "type": "header", "content": "Sub-brand logos" },
