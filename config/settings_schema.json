  },
  {
    "name": "Footer",
    "settings": [
      { "type": "select", "id": "footer_style", "label": "Footer style", "options": [
        { "value": "navy", "label": "Navy" },
        { "value": "sand", "label": "Sand" }
      ], "default": "navy" }
    ]
  },
  {
    "name": "Brand assets & SEO",
    "settings": [
      { "type": "image_picker", "id": "favicon", "label": "Favicon", "info": "Square PNG, at least 32×32." },
      { "type": "image_picker", "id": "social_share_image", "label": "Default social sharing image", "info": "Shown when pages are shared. 1200×630 recommended." },
      { "type": "text", "id": "business_name", "label": "Business name (structured data)", "default": "Center for Balanced Living" },
      { "type": "select", "id": "schema_business_type", "label": "Business type (structured data)", "options": [
        { "value": "MedicalBusiness", "label": "Medical business" },
        { "value": "Psychologist", "label": "Psychologist" },
        { "value": "ProfessionalService", "label": "Professional service" },
        { "value": "LocalBusiness", "label": "Local business" }
      ], "default": "Psychologist" },
      { "type": "text", "id": "business_phone", "label": "Phone" },
      { "type": "text", "id": "business_email", "label": "Email" },
      { "type": "text", "id": "business_street", "label": "Street address" },
      { "type": "text", "id": "business_city", "label": "City", "default": "Middletown" },
      { "type": "text", "id": "business_region", "label": "State/Region", "default": "DE" },
      { "type": "text", "id": "business_zip", "label": "ZIP / postal code" },
      { "type": "text", "id": "business_areas", "label": "Areas served (comma-separated)", "default": "Middletown, Townsend, Odessa, MOT, New Castle County, Delaware" }
    ]
  },
  {
    "name": "Social links",
    "settings": [
      { "type": "text", "id": "social_instagram", "label": "Instagram URL" },
      { "type": "text", "id": "social_facebook", "label": "Facebook URL" },
      { "type": "text", "id": "social_linkedin", "label": "LinkedIn URL" }
    ]
  },
  {
    "name": "Buttons & global CTAs",
    "settings": [
      { "type": "paragraph", "content": "Default calls-to-action available to sections that opt to use the global CTA." },
      { "type": "text", "id": "primary_cta_label", "label": "Primary CTA label", "default": "Request a Consultation" },
      { "type": "url", "id": "primary_cta_link", "label": "Primary CTA link" },
      { "type": "text", "id": "secondary_cta_label", "label": "Secondary CTA label", "default": "Explore Services" },
      { "type": "url", "id": "secondary_cta_link", "label": "Secondary CTA link" }
    ]
  },
  {
    "name": "Animations",
    "settings": [
      { "type": "checkbox", "id": "enable_animations", "label": "Enable subtle scroll animations", "default": true, "info": "Lightweight fade/rise on scroll. Automatically disabled for visitors who prefer reduced motion." }
    ]
  }
