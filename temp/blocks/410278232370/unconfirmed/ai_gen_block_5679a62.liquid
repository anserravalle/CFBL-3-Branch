{% doc %}
  @prompt
    image with text overlay with a customizable frame under the image, can you make the image the full width of the block
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-framed-image-{{ ai_gen_id }} {
    display: block;
    width: 100%;
  }

  .ai-framed-image__wrapper-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
  }

  .ai-framed-image__container-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    overflow: hidden;
    border-radius: {{ block.settings.image_border_radius }}px;
  }

  .ai-framed-image__image-{{ ai_gen_id }} {
    width: 100%;
    height: auto;
    display: block;
  }

  .ai-framed-image__placeholder-{{ ai_gen_id }} {
    width: 100%;
    aspect-ratio: 16 / 9;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
  }

  .ai-framed-image__placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    max-width: 500px;
    max-height: 500px;
  }

  .ai-framed-image__empty-state-{{ ai_gen_id }} {
    position: absolute;
    bottom: 20px;
    left: 50%;
    transform: translateX(-50%);
    padding: 12px 20px;
    font-size: 14px;
    color: #666;
    text-align: center;
    pointer-events: none;
  }

  .ai-framed-image__overlay-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: column;
    justify-content: {{ block.settings.text_vertical_alignment }};
    align-items: {{ block.settings.text_horizontal_alignment }};
    padding: {{ block.settings.overlay_padding }}px;
    background-color: {{ block.settings.overlay_color }};
    opacity: {{ block.settings.overlay_opacity }};
  }

  .ai-framed-image__text-content-{{ ai_gen_id }} {
    text-align: {{ block.settings.text_alignment }};
    max-width: {{ block.settings.text_max_width }}px;
  }

  .ai-framed-image__heading-{{ ai_gen_id }} {
    color: {{ block.settings.heading_color }};
    font-size: {{ block.settings.heading_size }}px;
    margin: 0 0 {{ block.settings.text_spacing }}px 0;
    line-height: 1.2;
  }

  .ai-framed-image__text-{{ ai_gen_id }} {
    color: {{ block.settings.text_color }};
    font-size: {{ block.settings.text_size }}px;
    margin: 0;
    line-height: 1.5;
  }

  .ai-framed-image__frame-{{ ai_gen_id }} {
    margin-top: {{ block.settings.frame_offset }}px;
    border: {{ block.settings.frame_thickness }}px {{ block.settings.frame_style }} {{ block.settings.frame_color }};
    border-radius: {{ block.settings.frame_border_radius }}px;
    padding: {{ block.settings.frame_padding }}px;
    background-color: {{ block.settings.frame_background }};
  }

  @media screen and (max-width: 749px) {
    .ai-framed-image__heading-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.heading_size }}px * 0.8);
    }

    .ai-framed-image__text-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.text_size }}px * 0.9);
    }

    .ai-framed-image__overlay-{{ ai_gen_id }} {
      padding: calc({{ block.settings.overlay_padding }}px * 0.7);
    }
  }
{% endstyle %}

<div class="ai-framed-image-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-framed-image__wrapper-{{ ai_gen_id }}">
    <div class="ai-framed-image__container-{{ ai_gen_id }}">
      {% if block.settings.image %}
        <img
          src="{{ block.settings.image | image_url: width: 2000 }}"
          alt="{{ block.settings.image.alt | escape }}"
          loading="lazy"
          width="{{ block.settings.image.width }}"
          height="{{ block.settings.image.height }}"
          class="ai-framed-image__image-{{ ai_gen_id }}"
        >
      {% else %}
        <div class="ai-framed-image__placeholder-{{ ai_gen_id }}">
          {{ 'hero-apparel-1' | placeholder_svg_tag }}
          <div class="ai-framed-image__empty-state-{{ ai_gen_id }}">
            Next, add an image
          </div>
        </div>
      {% endif %}

      {% if block.settings.show_overlay %}
        <div class="ai-framed-image__overlay-{{ ai_gen_id }}">
          <div class="ai-framed-image__text-content-{{ ai_gen_id }}">
            {% if block.settings.heading != blank %}
              <h2 class="ai-framed-image__heading-{{ ai_gen_id }}">{{ block.settings.heading }}</h2>
            {% endif %}
            {% if block.settings.text != blank %}
              <div class="ai-framed-image__text-{{ ai_gen_id }}">{{ block.settings.text }}</div>
            {% endif %}
          </div>
        </div>
      {% endif %}
    </div>

    {% if block.settings.show_frame %}
      <div class="ai-framed-image__frame-{{ ai_gen_id }}"></div>
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "Framed image with text",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "Image"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "range",
      "id": "image_border_radius",
      "label": "Image border radius",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 16
    },
    {
      "type": "header",
      "content": "Text overlay"
    },
    {
      "type": "checkbox",
      "id": "show_overlay",
      "label": "Show text overlay",
      "default": true
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "Your Story Matters"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "Discover the power of balanced living through our premium memoir collection and transformative workshops."
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "Text alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "center"
    },
    {
      "type": "select",
      "id": "text_vertical_alignment",
      "label": "Vertical position",
      "options": [
        {
          "value": "flex-start",
          "label": "Top"
        },
        {
          "value": "center",
          "label": "Middle"
        },
        {
          "value": "flex-end",
          "label": "Bottom"
        }
      ],
      "default": "center"
    },
    {
      "type": "select",
      "id": "text_horizontal_alignment",
      "label": "Horizontal position",
      "options": [
        {
          "value": "flex-start",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "flex-end",
          "label": "Right"
        }
      ],
      "default": "center"
    },
    {
      "type": "range",
      "id": "text_max_width",
      "label": "Text max width",
      "min": 300,
      "max": 800,
      "step": 50,
      "unit": "px",
      "default": 600
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Heading size",
      "min": 20,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "text_size",
      "label": "Text size",
      "min": 12,
      "max": 32,
      "step": 2,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "text_spacing",
      "label": "Spacing between heading and text",
      "min": 0,
      "max": 40,
      "step": 4,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "overlay_padding",
      "label": "Overlay padding",
      "min": 20,
      "max": 100,
      "step": 10,
      "unit": "px",
      "default": 40
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "overlay_color",
      "label": "Overlay background",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Overlay opacity",
      "min": 0,
      "max": 1,
      "step": 0.1,
      "default": 0.4
    },
    {
      "type": "header",
      "content": "Frame"
    },
    {
      "type": "checkbox",
      "id": "show_frame",
      "label": "Show frame",
      "default": true
    },
    {
      "type": "range",
      "id": "frame_offset",
      "label": "Frame offset",
      "min": -20,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": -10
    },
    {
      "type": "range",
      "id": "frame_thickness",
      "label": "Frame thickness",
      "min": 1,
      "max": 10,
      "step": 1,
      "unit": "px",
      "default": 2
    },
    {
      "type": "select",
      "id": "frame_style",
      "label": "Frame style",
      "options": [
        {
          "value": "solid",
          "label": "Solid"
        },
        {
          "value": "dashed",
          "label": "Dashed"
        },
        {
          "value": "dotted",
          "label": "Dotted"
        },
        {
          "value": "double",
          "label": "Double"
        }
      ],
      "default": "solid"
    },
    {
      "type": "range",
      "id": "frame_padding",
      "label": "Frame padding",
      "min": 10,
      "max": 60,
      "step": 5,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "frame_border_radius",
      "label": "Frame border radius",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 16
    },
    {
      "type": "color",
      "id": "frame_color",
      "label": "Frame color",
      "default": "#9D654E"
    },
    {
      "type": "color",
      "id": "frame_background",
      "label": "Frame background",
      "default": "#FBF6F0"
    }
  ],
  "presets": [
    {
      "name": "Framed image with text"
    }
  ]
}
{% endschema %}
