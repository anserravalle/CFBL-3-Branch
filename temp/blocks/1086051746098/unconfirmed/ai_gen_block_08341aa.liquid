{% doc %}
  @prompt
    i want a scrolling image with text, a small square image with a title role text, and a link to their bio page, I want it it scroll left to right, we need one more block image and can the block be a slate blue grey background and the text be a cream color, ok can the image have a coral frame, can the frame be a little more, the role be italicized and the name bolded, we have 10 team members, can oyu make the slate blue textured
{% enddoc %}
{% doc %}
  @prompt
    Team member scrolling cards with a subtle textured slate blue-grey background.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-team-strip-{{ ai_gen_id }} { display: block; width: 100%; overflow: hidden; padding: 28px 0; color: {{ block.settings.text_color }}; background-color: {{ block.settings.background_color }}; background-image: repeating-linear-gradient(113deg, rgba(255,255,255,.035) 0, rgba(255,255,255,.035) 1px, transparent 1px, transparent 5px), repeating-linear-gradient(23deg, rgba(20,35,48,.045) 0, rgba(20,35,48,.045) 1px, transparent 1px, transparent 7px), linear-gradient(135deg, rgba(255,255,255,.06), transparent 48%, rgba(20,35,48,.06)); }
  .ai-team-strip-{{ ai_gen_id }}__heading { margin: 0 auto 20px; padding: 0 20px; max-width: 1100px; color: {{ block.settings.text_color }}; font-size: 30px; text-align: center; }
  .ai-team-strip-{{ ai_gen_id }}__track { display: flex; align-items: stretch; gap: 18px; overflow-x: auto; overscroll-behavior-x: contain; scroll-snap-type: x mandatory; padding: 8px max(20px, calc((100vw - 1100px) / 2)) 16px; scrollbar-color: {{ block.settings.text_color }} {{ block.settings.background_color }}; scrollbar-width: thin; }
  .ai-team-strip-{{ ai_gen_id }}__card { flex: 0 0 285px; display: flex; align-items: center; gap: 15px; min-height: 112px; padding: 15px; background-color: {{ block.settings.background_color }}; background-image: repeating-linear-gradient(113deg, rgba(255,255,255,.035) 0, rgba(255,255,255,.035) 1px, transparent 1px, transparent 5px), repeating-linear-gradient(23deg, rgba(20,35,48,.045) 0, rgba(20,35,48,.045) 1px, transparent 1px, transparent 7px); border: 1px solid rgba(251,246,240,.45); border-radius: 12px; scroll-snap-align: start; }
  .ai-team-strip-{{ ai_gen_id }}__image, .ai-team-strip-{{ ai_gen_id }}__placeholder { box-sizing: border-box; width: 78px; height: 78px; flex: 0 0 78px; overflow: hidden; border: 8px solid {{ block.settings.frame_color }}; border-radius: 8px; background: {{ block.settings.text_color }}; }
  .ai-team-strip-{{ ai_gen_id }}__image { object-fit: cover; display: block; }
  .ai-team-strip-{{ ai_gen_id }}__placeholder svg { width: 100%; height: 100%; object-fit: cover; }
  .ai-team-strip-{{ ai_gen_id }}__details { min-width: 0; }
  .ai-team-strip-{{ ai_gen_id }}__name { margin: 0 0 4px; color: {{ block.settings.text_color }}; font-size: 18px; font-weight: 700; line-height: 1.2; }
  .ai-team-strip-{{ ai_gen_id }}__role { margin: 0 0 8px; color: {{ block.settings.text_color }}; font-size: 13px; font-style: italic; line-height: 1.4; }
  .ai-team-strip-{{ ai_gen_id }}__link { color: {{ block.settings.text_color }}; font-size: 13px; font-weight: 600; text-underline-offset: 3px; }
  .ai-team-strip-{{ ai_gen_id }}__link:focus-visible { outline: 2px solid {{ block.settings.text_color }}; outline-offset: 3px; }
  .ai-team-strip-{{ ai_gen_id }}__sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; border: 0; }
  @media (max-width: 749px) { .ai-team-strip-{{ ai_gen_id }}__heading { font-size: 25px; } .ai-team-strip-{{ ai_gen_id }}__card { flex-basis: 265px; } }
  @media (prefers-reduced-motion: reduce) { .ai-team-strip-{{ ai_gen_id }}__track { scroll-behavior: auto; } }
{% endstyle %}

<div class="ai-team-strip-{{ ai_gen_id }}" style="width: {{ block.settings.desktop_width_percent }}%;" {{ block.shopify_attributes }}>
  {% if block.settings.heading != blank %}<h2 class="ai-team-strip-{{ ai_gen_id }}__heading">{{ block.settings.heading | escape }}</h2>{% endif %}
  <div class="ai-team-strip-{{ ai_gen_id }}__track" aria-label="{{ block.settings.aria_label | escape }}" tabindex="0">
    {% for i in (1..10) %}
      {% assign image_key = 'person_' | append: i | append: '_image' %}
      {% assign name_key = 'person_' | append: i | append: '_name' %}
      {% assign role_key = 'person_' | append: i | append: '_role' %}
      {% assign link_key = 'person_' | append: i | append: '_link' %}
      {% assign person_image = block.settings[image_key] %}
      {% assign person_name = block.settings[name_key] %}
      {% assign person_role = block.settings[role_key] %}
      {% assign person_link = block.settings[link_key] %}
      {% if person_name != blank or person_image != blank %}
        <article class="ai-team-strip-{{ ai_gen_id }}__card">
          {% if person_image != blank %}<img class="ai-team-strip-{{ ai_gen_id }}__image" src="{{ person_image | image_url: width: 240 }}" alt="{{ person_image.alt | default: person_name | escape }}" width="78" height="78" loading="lazy">{% else %}<div class="ai-team-strip-{{ ai_gen_id }}__placeholder">{{ 'image' | placeholder_svg_tag }}</div>{% endif %}
          <div class="ai-team-strip-{{ ai_gen_id }}__details">
            {% if person_name != blank %}<h3 class="ai-team-strip-{{ ai_gen_id }}__name">{{ person_name | escape }}</h3>{% endif %}
            {% if person_role != blank %}<p class="ai-team-strip-{{ ai_gen_id }}__role">{{ person_role | escape }}</p>{% endif %}
            {% if person_link != blank %}<a class="ai-team-strip-{{ ai_gen_id }}__link" href="{{ person_link }}">{{ block.settings.link_label | escape }}{% if person_name != blank %} <span class="ai-team-strip-{{ ai_gen_id }}__sr-only">{{ person_name | escape }}</span>{% endif %}</a>{% endif %}
          </div>
        </article>
      {% endif %}
    {% endfor %}
  </div>
</div>

