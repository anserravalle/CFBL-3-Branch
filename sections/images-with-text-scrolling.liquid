{%- comment -%}
  Images with text, scrolling — a sticky media column that swaps/fades to match
  the text item currently in view (good for "Meet the Team"). Each block is an
  item: image + title + content. On mobile (and with reduced motion) it stacks
  as simple image+text pairs. Progressive enhancement: works with no JS.
{%- endcomment -%}
{%- liquid
  assign bg = section.settings.bg_scheme
  assign media_side = section.settings.image_position
-%}
<section class="section bg--{{ bg }}"
  style="--section-pt: {{ section.settings.padding_top }}px; --section-pb: {{ section.settings.padding_bottom }}px;">
  <div class="page-width">
    <div class="section__inner">
      {%- if section.settings.heading != blank or section.settings.eyebrow != blank -%}
        <div class="section__header {% if section.settings.text_align == 'center' %}is-center{% endif %} reveal">
          {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
          {%- if section.settings.heading != blank -%}<h2>{{ section.settings.heading }}</h2>{%- endif -%}
          {%- if section.settings.subheading != blank -%}<p class="section__subheading">{{ section.settings.subheading }}</p>{%- endif -%}
        </div>
      {%- endif -%}

      <div class="scroller scroller--media-{{ media_side }}" data-scroller>
        {%- comment -%} Sticky media stack (desktop). Each image is layered;
            JS toggles the active one. Without JS, the first image shows. {%- endcomment -%}
        <div class="scroller__media" aria-hidden="true">
          {%- for block in section.blocks -%}
            <div class="scroller__media-item {% if forloop.first %}is-active{% endif %}" data-media-index="{{ forloop.index0 }}">
              {%- if block.settings.image != blank -%}
                {%- render 'responsive-image', image: block.settings.image, alt: block.settings.title, ratio: section.settings.image_ratio, sizes: '(min-width:750px) 46vw, 100vw', widths: '480,640,800,1000' -%}
              {%- else -%}
                <div class="media media--{{ section.settings.image_ratio }}">{{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}</div>
              {%- endif -%}
            </div>
          {%- endfor -%}
        </div>

        <div class="scroller__text">
          {%- for block in section.blocks -%}
            <article class="scroller__item reveal" data-scroller-item data-index="{{ forloop.index0 }}" {{ block.shopify_attributes }}>
              {%- comment -%} Inline image — shown on mobile, hidden on desktop where the sticky column takes over. {%- endcomment -%}
              <div class="scroller__inline-media">
                {%- if block.settings.image != blank -%}
                  {%- render 'responsive-image', image: block.settings.image, alt: block.settings.title, ratio: section.settings.image_ratio, sizes: '100vw', widths: '480,640,800' -%}
                {%- endif -%}
              </div>
              {%- if block.settings.title != blank -%}<h3 class="scroller__title">{{ block.settings.title }}</h3>{%- endif -%}
              {%- if block.settings.role != blank -%}<p class="scroller__role">{{ block.settings.role }}</p>{%- endif -%}
              {%- if block.settings.content != blank -%}<div class="rte scroller__content">{{ block.settings.content }}</div>{%- endif -%}
            </article>
          {%- endfor -%}
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Images with text, scrolling",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Our Team" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Meet Our Team" },
    { "type": "richtext", "id": "subheading", "label": "Subheading" },
    { "type": "select", "id": "text_align", "label": "Header alignment", "options": [
      { "value": "left", "label": "Left" }, { "value": "center", "label": "Center" }
    ], "default": "center" },
    { "type": "select", "id": "image_position", "label": "Image side (desktop)", "options": [
      { "value": "start", "label": "Left" }, { "value": "end", "label": "Right" }
    ], "default": "start" },
    { "type": "select", "id": "image_ratio", "label": "Image ratio", "options": [
      { "value": "1-1", "label": "Square" }, { "value": "4-3", "label": "4:3" }, { "value": "3-2", "label": "3:2" }
    ], "default": "4-3" },
    { "type": "header", "content": "Appearance" },
    { "type": "select", "id": "bg_scheme", "label": "Background", "options": [
      { "value": "default", "label": "Page background" }, { "value": "sand", "label": "Sand" },
      { "value": "surface", "label": "White" }, { "value": "navy", "label": "Navy" }
    ], "default": "default" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 80 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 80 }
  ],
  "blocks": [
    { "type": "item", "name": "Person / item", "settings": [
      { "type": "image_picker", "id": "image", "label": "Image" },
      { "type": "text", "id": "title", "label": "Name / title", "default": "Team member" },
      { "type": "text", "id": "role", "label": "Role / credentials" },
      { "type": "richtext", "id": "content", "label": "Bio / content" }
    ]}
  ],
  "max_blocks": 20,
  "presets": [{ "name": "Images with text, scrolling", "blocks": [{ "type": "item" }, { "type": "item" }, { "type": "item" }] }]
}
{% endschema %}
