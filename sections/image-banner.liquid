{%- comment -%}
  Image banner - full-width image with overlaid heading, copy, and CTAs.
  Overlay opacity and alignment editable. Good for section dividers / page tops.
{%- endcomment -%}
{%- liquid
  assign align_class = ''
  if section.settings.text_align == 'center'
    assign align_class = 'is-center'
  endif
  assign htag = section.settings.use_h1
-%}
<section class="image-banner {{ align_class }}"
  style="--overlay-opacity: {{ section.settings.overlay_opacity | divided_by: 100.0 }};">
  <div class="image-banner__media media--{{ section.settings.height }}">
    {%- if section.settings.image != blank -%}
      {%- render 'responsive-image', image: section.settings.image, alt: section.settings.image_alt, loading: section.settings.eager, sizes: '100vw', widths: '768,1024,1440,1920,2400' -%}
    {%- else -%}
      <div class="media" style="background:var(--color-navy);width:100%;height:100%;"></div>
    {%- endif -%}
  </div>
  <div class="image-banner__overlay" style="min-height: {{ section.settings.min_height }}px;">
    <div class="page-width" style="width:100%;">
      <div class="image-banner__content reveal">
        {%- if section.settings.eyebrow != blank -%}<p class="eyebrow" style="color:var(--color-sand);">{{ section.settings.eyebrow }}</p>{%- endif -%}
        {%- if section.settings.use_h1 -%}
          <h1>{{ section.settings.heading }}</h1>
        {%- else -%}
          <h2>{{ section.settings.heading }}</h2>
        {%- endif -%}
        {%- if section.settings.body != blank -%}<div class="rte" style="color:var(--color-on-dark);">{{ section.settings.body }}</div>{%- endif -%}
        {%- if section.settings.primary_label != blank or section.settings.secondary_label != blank -%}
          <div class="btn-row bg--navy {% if align_class != '' %}is-center{% endif %}">
            {%- render 'button', label: section.settings.primary_label, href: section.settings.primary_link, style: 'primary' -%}
            {%- render 'button', label: section.settings.secondary_label, href: section.settings.secondary_link, style: 'secondary' -%}
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Image banner",
  "tag": "section",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Background image" },
    { "type": "text", "id": "image_alt", "label": "Image alt text" },
    { "type": "select", "id": "height", "label": "Banner ratio", "options": [
      { "value": "21-9", "label": "Wide (21:9)" }, { "value": "16-9", "label": "16:9" }, { "value": "4-3", "label": "4:3" }
    ], "default": "21-9" },
    { "type": "range", "id": "min_height", "label": "Minimum height", "min": 240, "max": 720, "step": 20, "unit": "px", "default": 420 },
    { "type": "range", "id": "overlay_opacity", "label": "Overlay darkness", "min": 0, "max": 90, "step": 5, "unit": "%", "default": 55 },
    { "type": "checkbox", "id": "eager", "label": "Load eagerly (use only at top of page)", "default": false },
    { "type": "header", "content": "Content" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Care that meets you where you are" },
    { "type": "checkbox", "id": "use_h1", "label": "Use as page H1", "default": false },
    { "type": "richtext", "id": "body", "label": "Body" },
    { "type": "select", "id": "text_align", "label": "Alignment", "options": [
      { "value": "left", "label": "Left" }, { "value": "center", "label": "Center" }
    ], "default": "left" },
    { "type": "header", "content": "Buttons" },
    { "type": "text", "id": "primary_label", "label": "Primary button label" },
    { "type": "url", "id": "primary_link", "label": "Primary button link" },
    { "type": "text", "id": "secondary_label", "label": "Secondary button label" },
    { "type": "url", "id": "secondary_link", "label": "Secondary button link" }
  ],
  "presets": [{ "name": "Image banner" }]
}
{% endschema %}
