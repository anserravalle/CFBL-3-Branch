{%- comment -%}
  Workshops & events - list of upcoming offerings. Each event is a block with
  date, title, details, and a registration link. Emits Event structured data.
{%- endcomment -%}
{%- liquid
  assign bg = section.settings.bg_scheme
-%}
<section class="section bg--{{ bg }}"
  style="--section-pt: {{ section.settings.padding_top }}px; --section-pb: {{ section.settings.padding_bottom }}px;">
  <div class="page-width">
    <div class="section__inner">
      {%- if section.settings.heading != blank or section.settings.eyebrow != blank -%}
        <div class="section__header {% if section.settings.text_align == 'center' %}is-center{% endif %} reveal">
          {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
          {%- if section.settings.heading != blank -%}<h2>{{ section.settings.heading }}</h2>{%- endif -%}
          {%- if section.settings.subheading != blank -%}<p class="section__subheading">{{ section.settings.subheading }}</p>{%- endif -%}
        </div>
      {%- endif -%}

      {%- if section.blocks.size > 0 -%}
        <div class="grid" style="gap:var(--space-16);">
          {%- for block in section.blocks -%}
            {%- liquid
              assign event_product = block.settings.product
              assign reg_label = block.settings.link_label | default: 'Register'
            -%}
            <article class="event reveal" {{ block.shopify_attributes }}>
              <div class="event__date">
                <span class="event__month">{{ block.settings.month }}</span>
                <span class="event__day">{{ block.settings.day }}</span>
              </div>
              <div>
                <h3 class="event__title">{{ block.settings.title }}</h3>
                <p class="event__detail">
                  {%- if block.settings.time != blank %}{%- render 'icon', name: 'clock', size: 14 -%} {{ block.settings.time }}{% endif -%}
                  {%- if block.settings.location != blank %} &middot; {{ block.settings.location }}{% endif -%}
                  {%- if event_product != blank %} &middot; {% if event_product.price > 0 %}{{ event_product.price | money }}{% else %}Free{% endif %}{% endif -%}
                </p>
                {%- if block.settings.description != blank -%}<p class="event__detail" style="margin-top:var(--space-8);">{{ block.settings.description }}</p>{%- endif -%}
                {%- if event_product != blank and event_product.available == false -%}
                  <p class="event__detail" style="margin-top:var(--space-8);color:var(--color-terracotta);font-weight:600;">Sold out / registration closed</p>
                {%- endif -%}
              </div>
              <div class="event__cta" style="display:flex;gap:var(--space-8);flex-wrap:wrap;align-items:center;">
                {%- liquid
                  assign learn_url = block.settings.learn_more
                  if learn_url == blank and event_product != blank
                    assign learn_url = event_product.url
                  endif
                -%}
                {%- if learn_url != blank -%}
                  {%- render 'button', label: block.settings.learn_more_label | default: 'Learn More', href: learn_url, style: 'tertiary', class: 'btn--sm', aria: 'Learn more about ' | append: block.settings.title -%}
                {%- endif -%}
                {%- if event_product != blank -%}
                  {%- comment -%} Native Shopify registration: add the seat product to cart and check out. Seat limits come from product inventory. {%- endcomment -%}
                  {%- if event_product.available -%}
                    <form method="post" action="{{ routes.cart_add_url }}" class="event__register">
                      <input type="hidden" name="id" value="{{ event_product.selected_or_first_available_variant.id }}">
                      <input type="hidden" name="quantity" value="1">
                      <button type="submit" class="btn btn--primary btn--sm" aria-label="{{ reg_label }} for {{ block.settings.title | escape }}">{{ reg_label }}</button>
                    </form>
                  {%- else -%}
                    <button type="button" class="btn btn--secondary btn--sm" disabled>Sold Out</button>
                  {%- endif -%}
                {%- elsif block.settings.link != blank -%}
                  {%- render 'button', label: reg_label, href: block.settings.link, style: 'secondary', class: 'btn--sm', aria: reg_label | append: ' for ' | append: block.settings.title -%}
                {%- endif -%}
              </div>
            </article>
          {%- endfor -%}
        </div>
      {%- else -%}
        <p class="section__subheading">Add events from this section's settings to list upcoming workshops.</p>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Workshops & events",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Groups & Workshops" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Upcoming Offerings" },
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "Therapy groups, workshops, and community education." },
    { "type": "select", "id": "text_align", "label": "Header alignment", "options": [
      { "value": "left", "label": "Left" }, { "value": "center", "label": "Center" }
    ], "default": "center" },
    { "type": "header", "content": "Appearance" },
    { "type": "select", "id": "bg_scheme", "label": "Background", "options": [
      { "value": "default", "label": "Page background" }, { "value": "sand", "label": "Sand" }, { "value": "sage", "label": "Sage" }, { "value": "surface", "label": "White" }, { "value": "cream", "label": "Cream" }, { "value": "navy", "label": "Navy (CFBL)" }, { "value": "institute", "label": "Institute green" }, { "value": "musa", "label": "MUSA maroon" }, { "value": "burnt", "label": "Burnt orange" }
    ], "default": "sand" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 80 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 80 }
  ],
  "blocks": [
    { "type": "event", "name": "Event", "settings": [
      { "type": "text", "id": "month", "label": "Month (short)", "default": "JUN" },
      { "type": "text", "id": "day", "label": "Day", "default": "12" },
      { "type": "text", "id": "title", "label": "Title", "default": "Trauma-Informed Skills Group" },
      { "type": "text", "id": "time", "label": "Time", "default": "6:00-7:30 PM" },
      { "type": "text", "id": "location", "label": "Location", "default": "Middletown, DE" },
      { "type": "text", "id": "description", "label": "Description" },
      { "type": "header", "content": "Learn more" },
      { "type": "url", "id": "learn_more", "label": "Learn More link", "info": "The detail page for this offering. Leave blank to use the selected product's page automatically." },
      { "type": "text", "id": "learn_more_label", "label": "Learn More button label", "default": "Learn More" },
      { "type": "header", "content": "Registration" },
      { "type": "product", "id": "product", "label": "Register via product (recommended)", "info": "Link this event to a Shopify product to take registrations and payment through checkout. Seat limits use the product's inventory." },
      { "type": "text", "id": "link_label", "label": "Register button label", "default": "Register" },
      { "type": "url", "id": "link", "label": "External link (used only if no product is selected)" }
    ]}
  ],
  "max_blocks": 20,
  "presets": [{ "name": "Workshops & events", "blocks": [{ "type": "event" }, { "type": "event" }] }]
}
{% endschema %}
