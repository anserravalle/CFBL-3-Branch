{%- comment -%}
  Testimonials / credibility quotes. Blocks are quotes (addable/reorderable).
  Use with care for a clinical practice - these can also hold clinician
  philosophy statements rather than client testimonials.
{%- endcomment -%}
{%- liquid
  assign bg = section.settings.bg_scheme
  assign count = section.blocks.size
  assign cols = section.settings.columns | at_most: count
  if cols < 1
    assign cols = 1
  endif
-%}
<section class="section bg--{{ bg }}"
  style="--section-pt: {{ section.settings.padding_top }}px; --section-pb: {{ section.settings.padding_bottom }}px;">
  <div class="page-width">
    <div class="section__inner">
      {%- if section.settings.heading != blank or section.settings.eyebrow != blank -%}
        <div class="section__header is-center reveal">
          {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
          {%- if section.settings.heading != blank -%}<h2>{{ section.settings.heading }}</h2>{%- endif -%}
          {%- if section.settings.subheading != blank -%}<p class="section__subheading">{{ section.settings.subheading }}</p>{%- endif -%}
        </div>
      {%- endif -%}

      <div class="grid grid--{{ cols }}">
        {%- for block in section.blocks -%}
          <figure class="testimonial reveal" {{ block.shopify_attributes }}>
            {%- if block.settings.rating > 0 -%}
              <div class="testimonial__rating" aria-label="Rated {{ block.settings.rating }} out of 5">
                {%- for i in (1..block.settings.rating) -%}{%- render 'icon', name: 'star', size: 16 -%}{%- endfor -%}
              </div>
            {%- endif -%}
            <blockquote class="testimonial__quote">{{ block.settings.quote }}</blockquote>
            <figcaption class="testimonial__meta">
              {%- if block.settings.avatar != blank -%}
                <span class="testimonial__avatar">{%- render 'responsive-image', image: block.settings.avatar, alt: block.settings.author, ratio: '1-1', sizes: '48px', widths: '48, 96, 144' -%}</span>
              {%- endif -%}
              <span>
                {%- if block.settings.author != blank -%}<span class="testimonial__name">{{ block.settings.author }}</span>{%- endif -%}
                {%- if block.settings.role != blank -%}<span class="testimonial__role">{{ block.settings.role }}</span>{%- endif -%}
              </span>
            </figcaption>
          </figure>
        {%- endfor -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Testimonials",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Our Philosophy of Care" },
    { "type": "text", "id": "subheading", "label": "Subheading" },
    { "type": "range", "id": "columns", "label": "Columns (desktop)", "min": 1, "max": 3, "step": 1, "default": 1 },
    { "type": "header", "content": "Appearance" },
    { "type": "select", "id": "bg_scheme", "label": "Background", "options": [
      { "value": "default", "label": "Page background" }, { "value": "sand", "label": "Sand" }, { "value": "sage", "label": "Sage" },
      { "value": "surface", "label": "White" }, { "value": "navy", "label": "Navy (CFBL)" }, { "value": "cream", "label": "Cream" }, { "value": "institute", "label": "Institute green" }, { "value": "musa", "label": "MUSA maroon" }, { "value": "burnt", "label": "Burnt orange" }
    ], "default": "sand" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 80 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 80 }
  ],
  "blocks": [
    { "type": "quote", "name": "Quote", "settings": [
      { "type": "richtext", "id": "quote", "label": "Quote", "default": "<p>My approach to care begins with the understanding that each person is unique. Treatment should be thoughtful, responsive, and grounded in both clinical depth and the needs of the individual.</p>" },
      { "type": "image_picker", "id": "avatar", "label": "Avatar (optional)" },
      { "type": "text", "id": "author", "label": "Author", "default": "Dr. Angela (Niki) Serravalle" },
      { "type": "text", "id": "role", "label": "Role / credentials", "default": "PsyD, LPCMH, NCC" },
      { "type": "range", "id": "rating", "label": "Star rating (0 to hide)", "min": 0, "max": 5, "step": 1, "default": 0 }
    ]}
  ],
  "max_blocks": 9,
  "presets": [{ "name": "Testimonials", "blocks": [{ "type": "quote" }] }]
}
{% endschema %}
