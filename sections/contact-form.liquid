{%- comment -%}
  Contact form - accessible Shopify contact form with structured fields:
  first name, last name, email, phone, a "reason for reaching out" dropdown
  (options set per page), a preferred-contact-method dropdown, and a message.
  Includes an editable response-time note and the emergency disclaimer on every
  page, with brand-matched intro copy. Submissions go to the store's contact
  inbox via Shopify's {% form 'contact' %}.
{%- endcomment -%}
{%- liquid
  assign bg = section.settings.bg_scheme
  assign reason_opts = section.settings.reason_options | split: ','
  assign method_opts = section.settings.method_options | split: ','
  assign use_h1 = section.settings.use_h1
-%}
<section class="section bg--{{ bg }}"
  style="--section-pt: {{ section.settings.padding_top }}px; --section-pb: {{ section.settings.padding_bottom }}px;">
  <div class="page-width">
    <div class="section__inner">
      {%- if section.settings.heading != blank or section.settings.eyebrow != blank -%}
        <div class="section__header reveal">
          {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
          {%- if section.settings.heading != blank -%}
            {%- if use_h1 -%}<h1>{{ section.settings.heading }}</h1>{%- else -%}<h2>{{ section.settings.heading }}</h2>{%- endif -%}
          {%- endif -%}
        </div>
      {%- endif -%}

      <div class="contact__grid">
        <div class="contact__info reveal">
          {%- if section.settings.intro != blank -%}<div class="rte">{{ section.settings.intro }}</div>{%- endif -%}
          <div class="contact__details" style="margin-top:var(--space-24);">
            {%- if section.settings.phone != blank -%}
              <p class="contact__detail">{%- render 'icon', name: 'phone', size: 20 -%} <a href="tel:{{ section.settings.phone | replace: ' ','' | replace: '(','' | replace: ')','' | replace: '-','' }}">{{ section.settings.phone }}</a></p>
            {%- endif -%}
            {%- if section.settings.email != blank -%}
              <p class="contact__detail">{%- render 'icon', name: 'mail', size: 20 -%} <a href="mailto:{{ section.settings.email }}">{{ section.settings.email }}</a></p>
            {%- endif -%}
            {%- if section.settings.whatsapp != blank -%}
              <p class="contact__detail">{%- render 'icon', name: 'whatsapp', size: 20 -%} <a href="https://wa.me/{{ section.settings.whatsapp | replace: ' ','' | replace: '+','' | replace: '(','' | replace: ')','' | replace: '-','' }}{% if section.settings.whatsapp_text != blank %}?text={{ section.settings.whatsapp_text | url_encode }}{% endif %}" target="_blank" rel="noopener">Message us on WhatsApp</a></p>
              <p class="contact__detail" style="font-size:var(--fs-xs);color:var(--color-muted);margin:calc(-1 * var(--space-8)) 0 0 0;">For brief, non-urgent questions only. Please do not share private health information by text.</p>
            {%- endif -%}
            {%- if section.settings.address != blank -%}
              <p class="contact__detail">{%- render 'icon', name: 'pin', size: 20 -%} <span>{{ section.settings.address }}</span></p>
            {%- endif -%}
            {%- if section.settings.hours != blank -%}
              <p class="contact__detail">{%- render 'icon', name: 'clock', size: 20 -%} <span>{{ section.settings.hours }}</span></p>
            {%- endif -%}
          </div>
          {%- if section.settings.response_note != blank -%}
            <p class="contact__detail" style="margin-top:var(--space-24);font-weight:600;color:var(--color-heading);">{{ section.settings.response_note }}</p>
          {%- endif -%}
          {%- if section.settings.disclaimer != blank -%}
            <div class="form-note form-note--error" style="margin-top:var(--space-16);font-weight:500;" role="note">{{ section.settings.disclaimer }}</div>
          {%- endif -%}
        </div>

        <div class="contact__form-wrap reveal">
          {%- form 'contact', class: 'form-grid' -%}
            {%- comment -%} Hidden routing marker: stamps every website submission so
                inbox filters can match form emails only (never stray client emails). {%- endcomment -%}
            <input type="hidden" name="contact[Submitted via]" value="CFBL website form (balancedlivingde.com)">
            {%- if form.posted_successfully? -%}
              <p class="form-note form-note--success" role="status" tabindex="-1">{{ section.settings.success_text }}</p>
            {%- elsif form.errors -%}
              <p class="form-note form-note--error" role="alert">{{ form.errors | default_errors }}</p>
            {%- endif -%}

            <div class="form-grid--2">
              <div class="field">
                <label for="ContactFirst-{{ section.id }}">First name</label>
                <input type="text" id="ContactFirst-{{ section.id }}" name="contact[First Name]" autocomplete="given-name" required>
              </div>
              <div class="field">
                <label for="ContactLast-{{ section.id }}">Last name</label>
                <input type="text" id="ContactLast-{{ section.id }}" name="contact[Last Name]" autocomplete="family-name" required>
              </div>
            </div>

            <div class="form-grid--2">
              <div class="field">
                <label for="ContactEmail-{{ section.id }}">Email</label>
                <input type="email" id="ContactEmail-{{ section.id }}" name="contact[email]" autocomplete="email" required value="{{ form.email }}">
              </div>
              <div class="field">
                <label for="ContactPhone-{{ section.id }}">Phone {% unless section.settings.phone_required %}<span style="font-weight:400;color:var(--color-muted);">(optional)</span>{% endunless %}</label>
                <input type="tel" id="ContactPhone-{{ section.id }}" name="contact[Phone]" autocomplete="tel" {% if section.settings.phone_required %}required{% endif %}>
              </div>
            </div>

            {%- if reason_opts.size > 0 -%}
              <div class="field">
                <label for="ContactReason-{{ section.id }}">{{ section.settings.reason_label }}</label>
                <select id="ContactReason-{{ section.id }}" name="contact[{{ section.settings.reason_label }}]" required>
                  <option value="">Please select...</option>
                  {%- for opt in reason_opts -%}<option value="{{ opt | strip | escape }}">{{ opt | strip }}</option>{%- endfor -%}
                </select>
              </div>
            {%- endif -%}

            {%- if method_opts.size > 0 -%}
              <div class="field">
                <label for="ContactMethod-{{ section.id }}">{{ section.settings.method_label }}</label>
                <select id="ContactMethod-{{ section.id }}" name="contact[Preferred Method of Contact]">
                  {%- for opt in method_opts -%}<option value="{{ opt | strip | escape }}">{{ opt | strip }}</option>{%- endfor -%}
                </select>
              </div>
            {%- endif -%}

            <div class="field">
              <label for="ContactMessage-{{ section.id }}">{{ section.settings.message_label }}</label>
              <textarea id="ContactMessage-{{ section.id }}" name="contact[body]" {% if section.settings.message_required %}required{% endif %}>{{ form.body }}</textarea>
            </div>

            <button type="submit" class="btn btn--primary btn--lg">{{ section.settings.button_label }}</button>
          {%- endform -%}
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Contact form",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Get in Touch" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Start the Conversation" },
    { "type": "checkbox", "id": "use_h1", "label": "Use heading as page H1", "default": true },
    { "type": "richtext", "id": "intro", "label": "Intro (brand-matched)", "default": "<p>Whether you are seeking therapy, an evaluation, or a first conversation, our team is here to help you take the next step. To speak with us directly, please call our office.</p>" },
    { "type": "text", "id": "phone", "label": "Phone", "default": "(302) 608-3780" },
    { "type": "text", "id": "email", "label": "Email" },
    { "type": "text", "id": "whatsapp", "label": "WhatsApp number", "info": "Digits with country code, e.g. 13028243722. Shows a 'Message us on WhatsApp' link. Leave blank to hide." },
    { "type": "text", "id": "whatsapp_text", "label": "WhatsApp pre-filled message", "default": "Hi, I'm reaching out from the Center for Balanced Living website.", "info": "Starts every website chat with this line so you can recognize and label website inquiries." },
    { "type": "html", "id": "address", "label": "Address" },
    { "type": "text", "id": "hours", "label": "Hours", "default": "By appointment" },
    { "type": "header", "content": "Form fields" },
    { "type": "checkbox", "id": "phone_required", "label": "Require phone", "default": false },
    { "type": "text", "id": "reason_label", "label": "Reason dropdown label", "default": "What are you reaching out about?" },
    { "type": "text", "id": "reason_options", "label": "Reason options (comma-separated)", "info": "Set per page, e.g. Therapy, Evaluation, Group on the clinical page.", "default": "Therapy, Psychological Evaluation, Group or Workshop, Something Else" },
    { "type": "text", "id": "method_label", "label": "Preferred contact label", "default": "Preferred method of contact" },
    { "type": "text", "id": "method_options", "label": "Preferred contact options", "default": "Email, Phone, Either" },
    { "type": "text", "id": "message_label", "label": "Message label", "default": "How can we help?" },
    { "type": "checkbox", "id": "message_required", "label": "Require message", "default": true },
    { "type": "header", "content": "Messaging" },
    { "type": "text", "id": "button_label", "label": "Submit button label", "default": "Send Message" },
    { "type": "text", "id": "success_text", "label": "Success message", "default": "Thank you. We usually reach out within 24-48 hours." },
    { "type": "text", "id": "response_note", "label": "Response-time note", "default": "We usually reach out within 24-48 hours." },
    { "type": "richtext", "id": "disclaimer", "label": "Emergency disclaimer", "default": "<p>This form is not intended for emergencies or urgent mental health concerns. If you are experiencing an emergency, call 911 or go to your nearest emergency room.</p>" },
    { "type": "header", "content": "Appearance" },
    { "type": "select", "id": "bg_scheme", "label": "Background", "options": [
      { "value": "default", "label": "Page background" }, { "value": "sand", "label": "Sand" }, { "value": "sage", "label": "Sage" }, { "value": "surface", "label": "White" }, { "value": "navy", "label": "Navy" }
    ], "default": "default" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 80 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 80 }
  ],
  "presets": [{ "name": "Contact form" }]
}
{% endschema %}
