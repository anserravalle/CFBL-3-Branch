{%- comment -%}
  Contact form - accessible Shopify contact form with optional dropdowns/fields
  as blocks, plus an editable info column (phone, hours, emergency disclaimer).
{%- endcomment -%}
{%- liquid
  assign bg = section.settings.bg_scheme
-%}
<section class="section bg--{{ bg }}"
  style="--section-pt: {{ section.settings.padding_top }}px; --section-pb: {{ section.settings.padding_bottom }}px;">
  <div class="page-width">
    <div class="section__inner">
      {%- if section.settings.heading != blank or section.settings.eyebrow != blank -%}
        <div class="section__header reveal">
          {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
          {%- if section.settings.heading != blank -%}<h1>{{ section.settings.heading }}</h1>{%- endif -%}
        </div>
      {%- endif -%}

      <div class="contact__grid">
        <div class="contact__info reveal">
          {%- if section.settings.intro != blank -%}<div class="rte">{{ section.settings.intro }}</div>{%- endif -%}
          <div class="contact__details" style="margin-top:var(--space-24);">
            {%- if section.settings.phone != blank -%}
              <p class="contact__detail">{%- render 'icon', name: 'phone', size: 20 -%} <a href="tel:{{ section.settings.phone | replace: ' ','' | replace: '(','' | replace: ')','' | replace: '-','' }}">{{ section.settings.phone }}</a></p>
            {%- endif -%}
            {%- if section.settings.email != blank -%}
              <p class="contact__detail">{%- render 'icon', name: 'mail', size: 20 -%} <a href="mailto:{{ section.settings.email }}">{{ section.settings.email }}</a></p>
            {%- endif -%}
            {%- if section.settings.address != blank -%}
              <p class="contact__detail">{%- render 'icon', name: 'pin', size: 20 -%} <span>{{ section.settings.address }}</span></p>
            {%- endif -%}
            {%- if section.settings.hours != blank -%}
              <p class="contact__detail">{%- render 'icon', name: 'clock', size: 20 -%} <span>{{ section.settings.hours }}</span></p>
            {%- endif -%}
          </div>
          {%- if section.settings.disclaimer != blank -%}
            <p class="form-note form-note--error" style="margin-top:var(--space-24);font-weight:500;" role="note">{{ section.settings.disclaimer }}</p>
          {%- endif -%}
        </div>

        <div class="contact__form-wrap reveal">
          {%- form 'contact', class: 'form-grid' -%}
            {%- if form.posted_successfully? -%}
              <p class="form-note form-note--success" role="status" tabindex="-1">{{ section.settings.success_text | default: 'Thank you. We typically respond within 24-48 hours.' }}</p>
            {%- elsif form.errors -%}
              <p class="form-note form-note--error" role="alert">{{ form.errors | default_errors }}</p>
            {%- endif -%}

            <div class="form-grid--2">
              <div class="field">
                <label for="ContactName">Name</label>
                <input type="text" id="ContactName" name="contact[name]" autocomplete="name" required value="{{ form.name }}">
              </div>
              <div class="field">
                <label for="ContactEmail">Email</label>
                <input type="email" id="ContactEmail" name="contact[email]" autocomplete="email" required value="{{ form.email }}">
              </div>
            </div>

            {%- for block in section.blocks -%}
              {%- case block.type -%}
                {%- when 'text' -%}
                  <div class="field" {{ block.shopify_attributes }}>
                    <label for="Contact-{{ block.id }}">{{ block.settings.title }}{% unless block.settings.required %} <span style="font-weight:400;color:var(--color-muted);">(optional)</span>{% endunless %}</label>
                    <input type="{{ block.settings.input_type | default: 'text' }}" id="Contact-{{ block.id }}" name="contact[{{ block.settings.title }}]" {% if block.settings.required %}required{% endif %}>
                  </div>
                {%- when 'dropdown' -%}
                  <div class="field" {{ block.shopify_attributes }}>
                    <label for="Contact-{{ block.id }}">{{ block.settings.title }}</label>
                    <select id="Contact-{{ block.id }}" name="contact[{{ block.settings.title }}]">
                      <option value="">Please select…</option>
                      {%- assign opts = block.settings.values | split: ',' -%}
                      {%- for opt in opts -%}<option value="{{ opt | strip }}">{{ opt | strip }}</option>{%- endfor -%}
                    </select>
                  </div>
              {%- endcase -%}
            {%- endfor -%}

            <div class="field">
              <label for="ContactMessage">How can we help?</label>
              <textarea id="ContactMessage" name="contact[body]" required>{{ form.body }}</textarea>
            </div>

            <button type="submit" class="btn btn--primary btn--lg">{{ section.settings.button_label | default: 'Send Message' }}</button>
          {%- endform -%}
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Contact form",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Get in Touch" },
    { "type": "text", "id": "heading", "label": "Heading (page H1)", "default": "Start the Conversation" },
    { "type": "richtext", "id": "intro", "label": "Intro", "default": "<p>Whether you are seeking therapy, evaluations, consultation, supervision, or training, our team is here to help you take the next step. To speak with us directly, please call our office. We typically respond to messages within 24-48 hours.</p>" },
    { "type": "text", "id": "phone", "label": "Phone", "default": "(302) 608-3780" },
    { "type": "text", "id": "email", "label": "Email" },
    { "type": "html", "id": "address", "label": "Address" },
    { "type": "text", "id": "hours", "label": "Hours", "default": "By appointment" },
    { "type": "text", "id": "button_label", "label": "Submit button label", "default": "Send Message" },
    { "type": "text", "id": "success_text", "label": "Success message", "default": "Thank you. We typically respond within 24-48 hours." },
    { "type": "richtext", "id": "disclaimer", "label": "Emergency disclaimer", "default": "<p>This form is not for emergencies or urgent mental health concerns. If you are experiencing an emergency, call 988 or 911, or go to your nearest emergency room.</p>" },
    { "type": "header", "content": "Appearance" },
    { "type": "select", "id": "bg_scheme", "label": "Background", "options": [
      { "value": "default", "label": "Page background" }, { "value": "sand", "label": "Sand" }, { "value": "surface", "label": "White" }
    ], "default": "default" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 80 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 80 }
  ],
  "blocks": [
    { "type": "text", "name": "Text field", "settings": [
      { "type": "text", "id": "title", "label": "Label", "default": "Phone Number" },
      { "type": "select", "id": "input_type", "label": "Input type", "options": [
        { "value": "text", "label": "Text" }, { "value": "tel", "label": "Phone" }, { "value": "email", "label": "Email" }
      ], "default": "tel" },
      { "type": "checkbox", "id": "required", "label": "Required", "default": false }
    ]},
    { "type": "dropdown", "name": "Dropdown", "settings": [
      { "type": "text", "id": "title", "label": "Label", "default": "How can we help?" },
      { "type": "text", "id": "values", "label": "Options (comma-separated)", "default": "Individual Therapy, Psychological Evaluation, Clinical Supervision, EMDR Consultation, Professional Training, Something Else" }
    ]}
  ],
  "max_blocks": 6,
  "presets": [{
    "name": "Contact form",
    "blocks": [
      { "type": "dropdown", "settings": { "title": "How can we help?", "values": "Individual Therapy, Psychological Evaluation, Clinical Supervision, EMDR Consultation, Professional Training, Something Else" } },
      { "type": "text", "settings": { "title": "Phone Number", "input_type": "tel", "required": false } },
      { "type": "dropdown", "settings": { "title": "Preferred Method Of Contact", "values": "Email, Phone, Either" } }
    ]
  }]
}
{% endschema %}
