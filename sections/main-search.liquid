{%- comment -%} Main search - query form + results (products, articles, pages). {%- endcomment -%}
<section class="section bg--default" style="--section-pt:72px;--section-pb:80px;">
  <div class="page-width">
    <div class="section__inner" style="max-width:900px;">
      <h1>{{ 'general.search.title' | t | default: 'Search' }}</h1>
      <form action="{{ routes.search_url }}" method="get" role="search" class="newsletter__form" style="margin-top:var(--space-16);">
        <label class="visually-hidden" for="SearchInput">{{ 'general.search.placeholder' | t | default: 'Search' }}</label>
        <input id="SearchInput" type="search" name="q" value="{{ search.terms | escape }}" placeholder="{{ 'general.search.placeholder' | t | default: 'Search' }}" class="input newsletter__inline">
        <button type="submit" class="btn btn--primary">{{ 'general.search.search' | t | default: 'Search' }}</button>
      </form>

      {%- if search.performed -%}
        <p class="article-card__meta" style="margin-top:var(--space-24);">{{ 'general.search.results_with_count' | t: count: search.results_count, terms: search.terms }}</p>
        {%- if search.results.size > 0 -%}
          <div class="grid" style="margin-top:var(--space-24);gap:var(--space-16);">
            {%- for item in search.results -%}
              <a href="{{ item.url }}" class="card is-linked" style="text-decoration:none;padding:var(--space-20) var(--space-24);">
                <h2 class="card__title" style="font-size:var(--fs-lg);margin:0;">{{ item.title }}</h2>
                {%- if item.content or item.description -%}
                  <p class="card__body" style="margin:var(--space-8) 0 0;">{{ item.content | default: item.description | strip_html | truncatewords: 28 }}</p>
                {%- endif -%}
              </a>
            {%- endfor -%}
          </div>
        {%- else -%}
          <p class="section__subheading">{{ 'general.search.no_results' | t: terms: search.terms }}</p>
        {%- endif -%}
      {%- endif -%}
    </div>
  </div>
</section>
{% schema %}
{ "name": "Search" }
{% endschema %}
