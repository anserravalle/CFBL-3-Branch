{%- comment -%}
  Book feature - a teaser for a single book. Cover (with a one-line caption),
  title, subtitle, description, and an optional excerpt set beneath the cover.
  Built for MUSA: literary, calm, the cover doing the emotional work.
  Pair with a Newsletter section set to its own list tag for the "notify" ask.
{%- endcomment -%}
{%- liquid
  assign bg = section.settings.bg_scheme
  assign s = section.settings
-%}
<section class="section book bg--{{ bg }}"
  style="--section-pt: {{ s.padding_top }}px; --section-pb: {{ s.padding_bottom }}px;">
  <div class="page-width">
    <div class="book__top">
      <div class="book__cover-col reveal">
        <figure class="book__cover {% if s.cover_frame %}is-framed{% endif %}"
          {% if s.frame_color != blank %}style="--frame-color: {{ s.frame_color }};"{% endif %}>
          {%- if s.cover != blank -%}
            {%- render 'responsive-image', image: s.cover, alt: s.cover_alt | default: s.title,
                ratio: s.cover_ratio, loading: 'lazy',
                sizes: '(min-width:990px) 40vw, 90vw', widths: '360,480,640,800,1000' -%}
          {%- else -%}
            <div class="media media--{{ s.cover_ratio }}">{{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}</div>
          {%- endif -%}
        </figure>
        {%- if s.cover_caption != blank -%}
          <figcaption class="book__caption">{{ s.cover_caption }}</figcaption>
        {%- endif -%}
      </div>

      <div class="book__intro reveal">
        {%- if s.eyebrow != blank -%}<p class="eyebrow">{{ s.eyebrow }}</p>{%- endif -%}
        {%- if s.title != blank -%}<h2 class="book__title">{{ s.title }}</h2>{%- endif -%}
        {%- if s.subtitle != blank -%}<p class="book__subtitle">{{ s.subtitle }}</p>{%- endif -%}
        {%- if s.description != blank -%}<div class="rte book__desc">{{ s.description }}</div>{%- endif -%}
        {%- if s.primary_label != blank -%}
          <div class="btn-row">
            {%- render 'button', label: s.primary_label, href: s.primary_link, style: 'primary' -%}
          </div>
        {%- endif -%}
      </div>
    </div>

    {%- if s.excerpt != blank -%}
      <div class="book__excerpt reveal">
        {%- if s.excerpt_label != blank -%}<p class="eyebrow book__excerpt-label">{{ s.excerpt_label }}</p>{%- endif -%}
        <div class="rte book__excerpt-body">{{ s.excerpt }}</div>
      </div>
    {%- endif -%}
  </div>
</section>

{%- if s.title != blank -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Book",
  "name": {{ s.title | json }},
  {% if s.subtitle != blank %}"alternativeHeadline": {{ s.subtitle | json }},{% endif %}
  "author": { "@type": "Person", "name": "Dr. Angela (Niki) Serravalle" }
  {%- if s.description != blank -%},
  "description": {{ s.description | strip_html | strip_newlines | json }}
  {%- endif -%}
}
</script>
{%- endif -%}

{% schema %}
{
  "name": "Book feature",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "The Book" },
    { "type": "text", "id": "title", "label": "Title", "default": "The Stories We Told" },
    { "type": "text", "id": "subtitle", "label": "Subtitle", "default": "The Dance of a Codependent and a Compulsive Liar" },
    { "type": "header", "content": "Cover" },
    { "type": "image_picker", "id": "cover", "label": "Cover image" },
    { "type": "text", "id": "cover_alt", "label": "Cover alt text" },
    { "type": "select", "id": "cover_ratio", "label": "Cover ratio", "options": [
      { "value": "2-3", "label": "Book (2:3)" }, { "value": "3-4", "label": "3:4" }, { "value": "4-3", "label": "4:3" }, { "value": "1-1", "label": "Square" }
    ], "default": "2-3" },
    { "type": "text", "id": "cover_caption", "label": "Caption under cover", "default": "The drawing is real. He made it on our first date." },
    { "type": "checkbox", "id": "cover_frame", "label": "Show offset frame behind cover", "default": true },
    { "type": "color", "id": "frame_color", "label": "Frame color (leave blank to match brand)", "default": "" },
    { "type": "header", "content": "Description" },
    { "type": "richtext", "id": "description", "label": "Book description", "default": "<p>The Stories We Told is the memoir of a clinical psychologist who knew the signs and stayed anyway.</p>" },
    { "type": "text", "id": "primary_label", "label": "Button label (optional)" },
    { "type": "url", "id": "primary_link", "label": "Button link (optional)" },
    { "type": "header", "content": "Excerpt" },
    { "type": "text", "id": "excerpt_label", "label": "Excerpt label", "default": "An excerpt" },
    { "type": "richtext", "id": "excerpt", "label": "Excerpt", "info": "Set spoken dialogue in italics to match the book." },
    { "type": "header", "content": "Appearance" },
    { "type": "select", "id": "bg_scheme", "label": "Background", "options": [
      { "value": "default", "label": "Page background" }, { "value": "sand", "label": "Sand" }, { "value": "sage", "label": "Sage" }, { "value": "surface", "label": "White" }, { "value": "navy", "label": "Navy" }
    ], "default": "surface" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 88 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 88 }
  ],
  "presets": [{ "name": "Book feature" }]
}
{% endschema %}
