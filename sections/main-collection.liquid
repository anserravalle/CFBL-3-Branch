{%- comment -%}
  Main collection — product grid for digital offerings (courses, programs,
  workshops). Calm, card-based, with pagination.
{%- endcomment -%}
{%- paginate collection.products by section.settings.per_page -%}
<div class="section bg--default" style="--section-pt: 72px; --section-pb: 80px;">
  <div class="page-width">
    <div class="section__inner">
      <header class="section__header is-center reveal">
        {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
        <h1>{{ collection.title }}</h1>
        {%- if collection.description != blank and section.settings.show_description -%}
          <div class="rte section__subheading">{{ collection.description }}</div>
        {%- endif -%}
      </header>

      {%- if collection.products.size > 0 -%}
        <div class="grid grid--3 mobile-2">
          {%- for product in collection.products -%}
            <a href="{{ product.url }}" class="article-card is-linked reveal" style="text-decoration:none;">
              {%- if product.featured_image -%}
                {%- render 'responsive-image', image: product.featured_image, alt: product.featured_image.alt | default: product.title, ratio: '4-3', sizes: '(min-width:990px) 360px, 50vw', widths: '300,450,600,800' -%}
              {%- endif -%}
              <div class="article-card__body">
                <h2 class="article-card__title" style="font-size:var(--fs-lg);">{{ product.title }}</h2>
                {%- if product.metafields.descriptors.subtitle -%}<p class="article-card__excerpt">{{ product.metafields.descriptors.subtitle }}</p>{%- endif -%}
                <p class="article-card__cta" style="margin-top:auto;font-weight:600;color:var(--color-navy);">
                  {%- if product.price > 0 -%}{{ product.price | money }}{%- else -%}{{ section.settings.free_label | default: 'Free' }}{%- endif -%}
                </p>
              </div>
            </a>
          {%- endfor -%}
        </div>

        {%- if paginate.pages > 1 -%}
          <nav class="pagination" aria-label="Pagination">
            {%- if paginate.previous -%}<a href="{{ paginate.previous.url }}" aria-label="Previous page">&larr;</a>{%- endif -%}
            {%- for part in paginate.parts -%}
              {%- if part.is_link -%}<a href="{{ part.url }}">{{ part.title }}</a>
              {%- else -%}<span {% if part.title == paginate.current_page %}aria-current="page"{% endif %}>{{ part.title }}</span>{%- endif -%}
            {%- endfor -%}
            {%- if paginate.next -%}<a href="{{ paginate.next.url }}" aria-label="Next page">&rarr;</a>{%- endif -%}
          </nav>
        {%- endif -%}
      {%- else -%}
        <p class="section__subheading" style="text-align:center;">No items in this collection yet.</p>
      {%- endif -%}
    </div>
  </div>
</div>
{%- endpaginate -%}

{% schema %}
{
  "name": "Collection",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "checkbox", "id": "show_description", "label": "Show collection description", "default": true },
    { "type": "text", "id": "free_label", "label": "Label for free items", "default": "Free" },
    { "type": "range", "id": "per_page", "label": "Products per page", "min": 6, "max": 24, "step": 3, "default": 12 }
  ]
}
{% endschema %}
