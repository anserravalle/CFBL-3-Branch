{%- comment -%}
  Tabs — tabbed content (e.g. "Areas of Evaluations"). Each tab block holds a
  title, a brief description, and a link to the full page. Accessible ARIA tabs
  with arrow-key navigation; the tab list scrolls horizontally on mobile.
{%- endcomment -%}
{%- liquid
  assign bg = section.settings.bg_scheme
  assign uid = section.id
-%}
<section class="section bg--{{ bg }}"
  style="--section-pt: {{ section.settings.padding_top }}px; --section-pb: {{ section.settings.padding_bottom }}px;">
  <div class="page-width">
    <div class="section__inner">
      {%- if section.settings.heading != blank or section.settings.eyebrow != blank -%}
        <div class="section__header {% if section.settings.text_align == 'center' %}is-center{% endif %} reveal">
          {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
          {%- if section.settings.heading != blank -%}<h2>{{ section.settings.heading }}</h2>{%- endif -%}
          {%- if section.settings.subheading != blank -%}<p class="section__subheading">{{ section.settings.subheading }}</p>{%- endif -%}
        </div>
      {%- endif -%}

      {%- if section.blocks.size > 0 -%}
        <div class="tabs reveal" data-tabs>
          <div class="tabs__list" role="tablist" aria-label="{{ section.settings.heading | default: 'Tabs' | escape }}">
            {%- for block in section.blocks -%}
              <button type="button" role="tab" class="tabs__tab"
                id="tab-{{ uid }}-{{ forloop.index }}"
                aria-controls="panel-{{ uid }}-{{ forloop.index }}"
                aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"
                tabindex="{% if forloop.first %}0{% else %}-1{% endif %}"
                {{ block.shopify_attributes }}>{{ block.settings.title }}</button>
            {%- endfor -%}
          </div>

          <div class="tabs__panels">
            {%- for block in section.blocks -%}
              {%- liquid
                assign tab_link = block.settings.link
                if tab_link == blank and block.settings.page != blank
                  assign tab_link = block.settings.page.url
                endif
              -%}
              <div role="tabpanel" class="tabs__panel"
                id="panel-{{ uid }}-{{ forloop.index }}"
                aria-labelledby="tab-{{ uid }}-{{ forloop.index }}"
                tabindex="0"
                {% unless forloop.first %}hidden{% endunless %}>
                {%- if block.settings.content != blank -%}<div class="rte">{{ block.settings.content }}</div>{%- endif -%}
                {%- if tab_link != blank -%}
                  <p style="margin-top: var(--space-20);">
                    {%- render 'button', label: block.settings.link_label | default: 'Learn more', href: tab_link, style: 'secondary', aria: block.settings.link_label | default: 'Learn more' | append: ' — ' | append: block.settings.title -%}
                  </p>
                {%- endif -%}
              </div>
            {%- endfor -%}
          </div>
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Tabs",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Types of Evaluations" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Areas of Evaluation" },
    { "type": "text", "id": "subheading", "label": "Subheading" },
    { "type": "select", "id": "text_align", "label": "Header alignment", "options": [
      { "value": "left", "label": "Left" }, { "value": "center", "label": "Center" }
    ], "default": "left" },
    { "type": "header", "content": "Appearance" },
    { "type": "select", "id": "bg_scheme", "label": "Background", "options": [
      { "value": "default", "label": "Page background" }, { "value": "sand", "label": "Sand" },
      { "value": "surface", "label": "White" }, { "value": "navy", "label": "Navy" }
    ], "default": "sand" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 80 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 80 }
  ],
  "blocks": [
    { "type": "tab", "name": "Tab", "settings": [
      { "type": "text", "id": "title", "label": "Tab title", "default": "Autism Spectrum" },
      { "type": "richtext", "id": "content", "label": "Description", "default": "<p>These evaluations help clarify questions related to autism spectrum presentation, including social communication, sensory experiences, and developmental history.</p>" },
      { "type": "page", "id": "page", "label": "Link to page" },
      { "type": "url", "id": "link", "label": "Or link URL", "info": "Used if no page is selected above." },
      { "type": "text", "id": "link_label", "label": "Link label", "default": "Learn more" }
    ]}
  ],
  "max_blocks": 12,
  "presets": [{
    "name": "Tabs",
    "blocks": [
      { "type": "tab", "settings": { "title": "Autism Spectrum" } },
      { "type": "tab", "settings": { "title": "Attention & Executive Functioning" } },
      { "type": "tab", "settings": { "title": "Academic & Learning" } }
    ]
  }]
}
{% endschema %}
