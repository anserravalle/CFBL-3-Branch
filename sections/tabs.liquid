{%- comment -%}
  Tabs - tabbed content. Each tab block holds a title, a description, an optional
  image OR video, and an optional link to a full page. When a tab has media, its
  panel becomes a two-column media + text layout. Accessible ARIA tabs with
  arrow-key navigation; the tab list scrolls horizontally on mobile.

  Reusable anywhere: Areas of Evaluation, therapy models & trainings, courses,
  workshops, and trainings (each tab can open to its own full page).
{%- endcomment -%}
{%- liquid
  assign bg = section.settings.bg_scheme
  assign uid = section.id
-%}
<section class="section bg--{{ bg }}"
  style="--section-pt: {{ section.settings.padding_top }}px; --section-pb: {{ section.settings.padding_bottom }}px;">
  <div class="page-width">
    <div class="section__inner">
      {%- if section.settings.heading != blank or section.settings.eyebrow != blank -%}
        <div class="section__header {% if section.settings.text_align == 'center' %}is-center{% endif %} reveal">
          {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
          {%- if section.settings.heading != blank -%}<h2>{{ section.settings.heading }}</h2>{%- endif -%}
          {%- if section.settings.subheading != blank -%}<p class="section__subheading">{{ section.settings.subheading }}</p>{%- endif -%}
        </div>
      {%- endif -%}

      {%- if section.blocks.size > 0 -%}
        <div class="tabs reveal" data-tabs>
          <div class="tabs__list" role="tablist" aria-label="{{ section.settings.heading | default: 'Tabs' | escape }}">
            {%- for block in section.blocks -%}
              <button type="button" role="tab" class="tabs__tab"
                id="tab-{{ uid }}-{{ forloop.index }}"
                aria-controls="panel-{{ uid }}-{{ forloop.index }}"
                aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"
                tabindex="{% if forloop.first %}0{% else %}-1{% endif %}"
                {{ block.shopify_attributes }}>{{ block.settings.title }}</button>
            {%- endfor -%}
          </div>

          <div class="tabs__panels">
            {%- for block in section.blocks -%}
              {%- liquid
                assign tab_link = block.settings.link
                if tab_link == blank and block.settings.page != blank
                  assign tab_link = block.settings.page.url
                endif
                assign has_media = false
                if block.settings.image != blank or block.settings.video_url != blank
                  assign has_media = true
                endif
              -%}
              <div role="tabpanel" class="tabs__panel{% if has_media %} tabs__panel--media{% endif %}"
                id="panel-{{ uid }}-{{ forloop.index }}"
                aria-labelledby="tab-{{ uid }}-{{ forloop.index }}"
                tabindex="0"
                {% unless forloop.first %}hidden{% endunless %}>

                {%- if has_media -%}
                  <div class="tabs__panel-media">
                    {%- if block.settings.video_url != blank -%}
                      <div class="video-wrap">
                        <iframe src="{{ block.settings.video_url }}" title="{{ block.settings.title | escape }}" allow="encrypted-media; picture-in-picture" allowfullscreen loading="lazy"></iframe>
                      </div>
                    {%- else -%}
                      {%- render 'responsive-image', image: block.settings.image, alt: block.settings.image_alt | default: block.settings.title, ratio: section.settings.image_ratio, sizes: '(min-width:750px) 46vw, 100vw', widths: '480,640,800,1000' -%}
                    {%- endif -%}
                  </div>
                {%- endif -%}

                <div class="tabs__panel-body">
                  {%- if block.settings.heading != blank -%}<h3>{{ block.settings.heading }}</h3>{%- endif -%}
                  {%- if block.settings.content != blank -%}<div class="rte">{{ block.settings.content }}</div>{%- endif -%}
                  {%- if tab_link != blank -%}
                    <p style="margin-top: var(--space-20);">
                      {%- assign tl = block.settings.link_label | default: 'Learn more' -%}
                      {%- assign tab_external = false -%}
                      {%- if tab_link contains '://' -%}{%- assign tab_external = true -%}{%- endif -%}
                      {%- render 'button', label: tl, href: tab_link, style: 'secondary', new_tab: tab_external, aria: tl | append: ', ' | append: block.settings.title -%}
                    </p>
                  {%- endif -%}
                </div>
              </div>
            {%- endfor -%}
          </div>
        </div>
        {%- if section.settings.footer_label != blank -%}
          <div class="btn-row {% if section.settings.text_align == 'center' %}is-center{% endif %}" style="margin-top: var(--space-32);">
            {%- render 'button', label: section.settings.footer_label, href: section.settings.footer_link, style: section.settings.footer_style | default: 'secondary' -%}
          </div>
        {%- endif -%}
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Tabs",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Explore" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Areas of Evaluation" },
    { "type": "text", "id": "subheading", "label": "Subheading" },
    { "type": "select", "id": "text_align", "label": "Header alignment", "options": [
      { "value": "left", "label": "Left" }, { "value": "center", "label": "Center" }
    ], "default": "left" },
    { "type": "select", "id": "image_ratio", "label": "Media ratio (tabs with images)", "options": [
      { "value": "4-3", "label": "4:3" }, { "value": "3-2", "label": "3:2" }, { "value": "1-1", "label": "Square" }, { "value": "16-9", "label": "16:9" }
    ], "default": "4-3" },
    { "type": "header", "content": "Section button (below tabs)" },
    { "type": "text", "id": "footer_label", "label": "Button label" },
    { "type": "url", "id": "footer_link", "label": "Button link" },
    { "type": "select", "id": "footer_style", "label": "Button style", "options": [
      { "value": "primary", "label": "Primary" }, { "value": "secondary", "label": "Secondary" }, { "value": "tertiary", "label": "Text link" }
    ], "default": "secondary" },
    { "type": "header", "content": "Appearance" },
    { "type": "select", "id": "bg_scheme", "label": "Background", "options": [
      { "value": "default", "label": "Page background" }, { "value": "sand", "label": "Sand" }, { "value": "sage", "label": "Sage" },
      { "value": "surface", "label": "White" }, { "value": "navy", "label": "Navy" }
    ], "default": "sand" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 80 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 80 }
  ],
  "blocks": [
    { "type": "tab", "name": "Tab", "settings": [
      { "type": "text", "id": "title", "label": "Tab label", "default": "Tab title" },
      { "type": "text", "id": "heading", "label": "Panel heading (optional)" },
      { "type": "richtext", "id": "content", "label": "Description", "default": "<p>Describe this item. Add an image or video below for a richer panel, and link to a full page if there is one.</p>" },
      { "type": "header", "content": "Media (optional)" },
      { "type": "image_picker", "id": "image", "label": "Image" },
      { "type": "text", "id": "image_alt", "label": "Image alt text" },
      { "type": "video_url", "id": "video_url", "label": "Video URL (overrides image)", "accept": ["youtube", "vimeo"] },
      { "type": "header", "content": "Link to full page (optional)" },
      { "type": "page", "id": "page", "label": "Link to page" },
      { "type": "url", "id": "link", "label": "Or link URL", "info": "Used if no page is selected above." },
      { "type": "text", "id": "link_label", "label": "Link label", "default": "Learn more" }
    ]}
  ],
  "max_blocks": 24,
  "presets": [{
    "name": "Tabs",
    "blocks": [
      { "type": "tab", "settings": { "title": "Tab one" } },
      { "type": "tab", "settings": { "title": "Tab two" } },
      { "type": "tab", "settings": { "title": "Tab three" } }
    ]
  }]
}
{% endschema %}
