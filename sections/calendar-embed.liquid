{%- comment -%}
  Calendar embed - a framed, responsive Google Calendar (or any embeddable
  calendar). Paste the calendar's embed "src" URL in the section settings.
  Falls back to a friendly prompt + button when no calendar is set.
{%- endcomment -%}
{%- liquid
  assign bg = section.settings.bg_scheme
  assign htag = section.settings.heading_tag | default: 'h2'
  assign src = section.settings.calendar_src
-%}
<section class="section bg--{{ bg }}"
  style="--section-pt: {{ section.settings.padding_top }}px; --section-pb: {{ section.settings.padding_bottom }}px;">
  <div class="page-width">
    <div class="section__inner reveal" style="text-align: {{ section.settings.text_align }};">
      {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
      {%- if section.settings.heading != blank -%}<{{ htag }}>{{ section.settings.heading }}</{{ htag }}>{%- endif -%}
      {%- if section.settings.subheading != blank -%}<div class="rte" style="max-width:760px;margin-inline:auto;">{{ section.settings.subheading }}</div>{%- endif -%}
    </div>

    {%- if src != blank -%}
      <div class="calendar-embed reveal" style="max-width: {{ section.settings.max_width }}px; margin-inline:auto;">
        <iframe
          src="{{ src }}"
          title="{{ section.settings.iframe_title | escape }}"
          style="border:0; width:100%; height:{{ section.settings.height }}px;"
          frameborder="0"
          scrolling="no"
          loading="lazy"></iframe>
      </div>
    {%- else -%}
      <div class="calendar-embed calendar-embed--empty reveal" style="max-width: {{ section.settings.max_width }}px; margin-inline:auto; text-align:center;">
        <p class="rte">Add your Google Calendar embed link in the theme editor to display the live calendar here.</p>
      </div>
    {%- endif -%}

    {%- if section.settings.button_label != blank -%}
      <div class="btn-row is-center" style="margin-top:24px;">
        {%- render 'button', label: section.settings.button_label, href: section.settings.button_link, style: section.settings.button_style, new_tab: true -%}
      </div>
    {%- endif -%}
  </div>
</section>

<style>
  .calendar-embed {
    background: rgb(var(--color-surface, 255 255 255));
    border: 1px solid rgba(var(--color-foreground, 20 30 40), 0.08);
    border-radius: var(--radius-lg, 16px);
    padding: 12px;
    box-shadow: var(--shadow-soft, 0 10px 30px rgba(20,30,40,0.06));
    overflow: hidden;
  }
  .calendar-embed iframe { display:block; border-radius: var(--radius-md, 10px); }
  .calendar-embed--empty { padding: 48px 24px; }
</style>

{% schema %}
{
  "name": "Calendar embed",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Event Calendar" },
    { "type": "select", "id": "heading_tag", "label": "Heading level (SEO)", "options": [
      { "value": "h1", "label": "H1" }, { "value": "h2", "label": "H2" }, { "value": "h3", "label": "H3" }
    ], "default": "h2", "info": "Use only one H1 per page." },
    { "type": "richtext", "id": "subheading", "label": "Intro text" },
    { "type": "header", "content": "Calendar" },
    { "type": "text", "id": "calendar_src", "label": "Google Calendar embed URL (src)", "info": "In Google Calendar: Settings > your calendar > Integrate calendar > copy the URL inside the iframe's src=\"...\"." },
    { "type": "text", "id": "iframe_title", "label": "Accessible title", "default": "Center for Balanced Living event calendar" },
    { "type": "range", "id": "height", "label": "Calendar height", "min": 400, "max": 1000, "step": 20, "unit": "px", "default": 680 },
    { "type": "range", "id": "max_width", "label": "Max width", "min": 600, "max": 1200, "step": 20, "unit": "px", "default": 960 },
    { "type": "header", "content": "Button" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Open full calendar" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "select", "id": "button_style", "label": "Button style", "options": [
      { "value": "primary", "label": "Primary" }, { "value": "secondary", "label": "Secondary" }, { "value": "tertiary", "label": "Text link" }
    ], "default": "secondary" },
    { "type": "header", "content": "Appearance" },
    { "type": "select", "id": "text_align", "label": "Text alignment", "options": [
      { "value": "left", "label": "Left" }, { "value": "center", "label": "Center" }
    ], "default": "center" },
    { "type": "select", "id": "bg_scheme", "label": "Background", "options": [
      { "value": "default", "label": "Page background" }, { "value": "sand", "label": "Sand" }, { "value": "sage", "label": "Sage" },
      { "value": "surface", "label": "White" }, { "value": "navy", "label": "Navy" }
    ], "default": "default" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 24 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 80 }
  ],
  "presets": [{ "name": "Calendar embed" }]
}
{% endschema %}
