{%- comment -%} Main list-collections - grid of all collections. {%- endcomment -%}
<section class="section bg--default" style="--section-pt:72px;--section-pb:80px;">
  <div class="page-width">
    <div class="section__inner">
      <header class="section__header is-center reveal">
        <h1>{{ section.settings.heading | default: 'Programs & Offerings' }}</h1>
        {%- if section.settings.subheading != blank -%}<p class="section__subheading">{{ section.settings.subheading }}</p>{%- endif -%}
      </header>
      <div class="grid grid--3 mobile-2">
        {%- for collection in collections -%}
          <a href="{{ collection.url }}" class="article-card is-linked reveal" style="text-decoration:none;">
            {%- if collection.featured_image -%}
              {%- render 'responsive-image', image: collection.featured_image, alt: collection.title, ratio: '4-3', sizes: '(min-width:990px) 360px, 50vw', widths: '300,450,600,800' -%}
            {%- endif -%}
            <div class="article-card__body">
              <h2 class="article-card__title" style="font-size:var(--fs-lg);">{{ collection.title }}</h2>
              <p class="article-card__meta" style="margin:0;">{{ collection.products_count }} items</p>
            </div>
          </a>
        {%- endfor -%}
      </div>
    </div>
  </div>
</section>
{% schema %}
{
  "name": "Collections list",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Programs & Offerings" },
    { "type": "text", "id": "subheading", "label": "Subheading" }
  ]
}
{% endschema %}
