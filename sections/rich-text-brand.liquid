{%- comment -%}
  Rich text - a flexible prose block for positioning statements, local-SEO
  paragraphs, or any editorial copy. Heading tag configurable to preserve
  page heading hierarchy.
{%- endcomment -%}
{%- liquid
  assign bg = section.settings.bg_scheme
  assign htag = section.settings.heading_tag | default: 'h2'
-%}
<section class="section bg--{{ bg }}"
  style="--section-pt: {{ section.settings.padding_top }}px; --section-pb: {{ section.settings.padding_bottom }}px;">
  <div class="page-width">
    <div class="section__inner reveal" style="max-width: {{ section.settings.content_width }}px; margin-inline:auto; text-align: {{ section.settings.text_align }};">
      {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
      {%- if section.settings.heading != blank -%}<{{ htag }}>{{ section.settings.heading }}</{{ htag }}>{%- endif -%}
      {%- if section.settings.content != blank -%}<div class="rte">{{ section.settings.content }}</div>{%- endif -%}
      {%- if section.settings.button_label != blank -%}
        <div class="btn-row {% if section.settings.text_align == 'center' %}is-center{% endif %}">
          {%- render 'button', label: section.settings.button_label, href: section.settings.button_link, style: section.settings.button_style -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Rich text",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading" },
    { "type": "select", "id": "heading_tag", "label": "Heading level (SEO)", "options": [
      { "value": "h1", "label": "H1" }, { "value": "h2", "label": "H2" }, { "value": "h3", "label": "H3" }
    ], "default": "h2", "info": "Use only one H1 per page." },
    { "type": "richtext", "id": "content", "label": "Content", "default": "<p>Center for Balanced Living serves clients throughout Delaware, including Middletown, Townsend, Wilmington, Newark, and Dover.</p>" },
    { "type": "select", "id": "text_align", "label": "Text alignment", "options": [
      { "value": "left", "label": "Left" }, { "value": "center", "label": "Center" }
    ], "default": "center" },
    { "type": "range", "id": "content_width", "label": "Content width", "min": 480, "max": 1100, "step": 20, "unit": "px", "default": 760 },
    { "type": "header", "content": "Button" },
    { "type": "text", "id": "button_label", "label": "Button label" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "select", "id": "button_style", "label": "Button style", "options": [
      { "value": "primary", "label": "Primary" }, { "value": "secondary", "label": "Secondary" }, { "value": "tertiary", "label": "Text link" }
    ], "default": "primary" },
    { "type": "header", "content": "Appearance" },
    { "type": "select", "id": "bg_scheme", "label": "Background", "options": [
      { "value": "default", "label": "Page background" }, { "value": "sand", "label": "Sand" }, { "value": "sage", "label": "Sage" },
      { "value": "surface", "label": "White" }, { "value": "navy", "label": "Navy" }
    ], "default": "surface" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 64 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 64 }
  ],
  "presets": [{ "name": "Rich text" }]
}
{% endschema %}
