{%- comment -%}
  Video - supports a self-hosted Shopify video OR an external URL (YouTube/
  Vimeo). Click-to-load poster keeps the page fast; accessible labels included.
{%- endcomment -%}
{%- liquid
  assign bg = section.settings.bg_scheme
-%}
<section class="section bg--{{ bg }}"
  style="--section-pt: {{ section.settings.padding_top }}px; --section-pb: {{ section.settings.padding_bottom }}px;">
  <div class="page-width">
    <div class="section__inner">
      {%- if section.settings.heading != blank or section.settings.eyebrow != blank -%}
        <div class="section__header is-center reveal">
          {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
          {%- if section.settings.heading != blank -%}<h2>{{ section.settings.heading }}</h2>{%- endif -%}
          {%- if section.settings.subheading != blank -%}<p class="section__subheading">{{ section.settings.subheading }}</p>{%- endif -%}
        </div>
      {%- endif -%}

      <div class="video-wrap reveal" data-video-wrap style="max-width:{{ section.settings.max_width }}px;margin-inline:auto;">
        {%- if section.settings.video != blank -%}
          {{ section.settings.video | video_tag: image_size: '1100x', loop: false, controls: true, muted: false, preload: 'none' }}
        {%- elsif section.settings.video_url != blank -%}
          {%- if section.settings.poster != blank -%}
            <button type="button" class="video-trigger" data-video-trigger aria-label="Play video: {{ section.settings.heading | default: 'video' | escape }}" style="all:unset;cursor:pointer;display:block;">
              <img class="video-poster" src="{{ section.settings.poster | image_url: width: 1200 }}" alt="{{ section.settings.poster.alt | default: section.settings.heading | escape }}" loading="lazy" width="1100" height="619">
              <span class="video-play" aria-hidden="true">{%- render 'icon', name: 'play', size: 26 -%}</span>
            </button>
            <template data-video-embed>
              <iframe src="{{ section.settings.video_url | append: '?autoplay=1' }}" title="{{ section.settings.heading | default: 'Video' | escape }}" allow="autoplay; encrypted-media; picture-in-picture" allowfullscreen loading="lazy"></iframe>
            </template>
          {%- else -%}
            <iframe src="{{ section.settings.video_url }}" title="{{ section.settings.heading | default: 'Video' | escape }}" allow="encrypted-media; picture-in-picture" allowfullscreen loading="lazy"></iframe>
          {%- endif -%}
        {%- else -%}
          <div class="media media--16-9">{{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}</div>
        {%- endif -%}
      </div>
      {%- if section.settings.caption != blank -%}
        <p class="form-note" style="text-align:center;margin-top:var(--space-16);color:var(--color-muted);">{{ section.settings.caption }}</p>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Video",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Meet Our Practice" },
    { "type": "text", "id": "subheading", "label": "Subheading" },
    { "type": "video", "id": "video", "label": "Shopify-hosted video" },
    { "type": "video_url", "id": "video_url", "label": "Or external video URL", "accept": ["youtube", "vimeo"] },
    { "type": "image_picker", "id": "poster", "label": "Poster image (for external video)" },
    { "type": "text", "id": "caption", "label": "Caption / accessible note" },
    { "type": "range", "id": "max_width", "label": "Max width", "min": 600, "max": 1200, "step": 20, "unit": "px", "default": 960 },
    { "type": "header", "content": "Appearance" },
    { "type": "select", "id": "bg_scheme", "label": "Background", "options": [
      { "value": "default", "label": "Page background" }, { "value": "sand", "label": "Sand" },
      { "value": "surface", "label": "White" }, { "value": "navy", "label": "Navy" }
    ], "default": "default" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 80 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 80 }
  ],
  "presets": [{ "name": "Video" }]
}
{% endschema %}
