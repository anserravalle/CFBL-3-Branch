{%- comment -%}
  Contact CTA - a calm, confident closing band. Heading, supporting line, two
  CTAs, optional phone. Often placed last on a page to make the next step clear.
{%- endcomment -%}
{%- liquid
  assign bg = section.settings.bg_scheme
-%}
<section class="section bg--{{ bg }}"
  style="--section-pt: {{ section.settings.padding_top }}px; --section-pb: {{ section.settings.padding_bottom }}px;">
  <div class="page-width">
    <div class="section__inner section__header is-center reveal" style="margin-bottom:0;">
      {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
      {%- if section.settings.heading != blank -%}<h2>{{ section.settings.heading }}</h2>{%- endif -%}
      {%- if section.settings.body != blank -%}<div class="rte section__subheading">{{ section.settings.body }}</div>{%- endif -%}
      <div class="btn-row is-center">
        {%- render 'button', label: section.settings.primary_label, href: section.settings.primary_link, style: 'primary', class: 'btn--lg' -%}
        {%- render 'button', label: section.settings.secondary_label, href: section.settings.secondary_link, style: 'secondary' -%}
      </div>
      {%- if section.settings.phone != blank -%}
        <p style="margin-top: var(--space-24); font-size: var(--fs-md);">
          {%- render 'icon', name: 'phone', size: 18 -%}
          <a href="tel:{{ section.settings.phone | replace: ' ', '' | replace: '(', '' | replace: ')', '' | replace: '-', '' }}">{{ section.settings.phone }}</a>
        </p>
      {%- endif -%}
      {%- if section.settings.disclaimer != blank -%}
        <p style="margin-top: var(--space-16); font-size: var(--fs-sm); opacity: 0.85;">{{ section.settings.disclaimer }}</p>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Contact CTA",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Take the Next Step" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Healing happens in relationship" },
    { "type": "richtext", "id": "body", "label": "Body", "default": "<p>Whether you are seeking therapy, an evaluation, consultation, or training, we are here to help you take a clear next step.</p>" },
    { "type": "header", "content": "Buttons" },
    { "type": "text", "id": "primary_label", "label": "Primary button label", "default": "Start the Conversation" },
    { "type": "url", "id": "primary_link", "label": "Primary button link" },
    { "type": "text", "id": "secondary_label", "label": "Secondary button label", "default": "Explore Services" },
    { "type": "url", "id": "secondary_link", "label": "Secondary button link" },
    { "type": "text", "id": "phone", "label": "Phone", "default": "(302) 608-3780" },
    { "type": "text", "id": "disclaimer", "label": "Disclaimer", "default": "This is not for emergencies. If you are in crisis, call 988 or 911, or go to your nearest emergency room." },
    { "type": "header", "content": "Appearance" },
    { "type": "select", "id": "bg_scheme", "label": "Background", "options": [
      { "value": "navy", "label": "Navy (CFBL)" }, { "value": "cream", "label": "Cream" }, { "value": "institute", "label": "Institute green" }, { "value": "musa", "label": "MUSA maroon" }, { "value": "burnt", "label": "Burnt orange" }, { "value": "sand", "label": "Sand" }, { "value": "sage", "label": "Sage" },
      { "value": "default", "label": "Page background" }, { "value": "surface", "label": "White" }
    ], "default": "navy" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 96 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 96 }
  ],
  "presets": [{ "name": "Contact CTA" }]
}
{% endschema %}
