{%- comment -%}
  Credentials & trust - credential blocks (icon + title + text) and optional
  affiliation logos. Communicates clinical credibility without overpromising.
{%- endcomment -%}
{%- liquid
  assign bg = section.settings.bg_scheme
  assign cols = section.settings.columns
-%}
<section class="section bg--{{ bg }}"
  style="--section-pt: {{ section.settings.padding_top }}px; --section-pb: {{ section.settings.padding_bottom }}px;">
  <div class="page-width">
    <div class="section__inner">
      {%- if section.settings.heading != blank or section.settings.eyebrow != blank -%}
        <div class="section__header {% if section.settings.text_align == 'center' %}is-center{% endif %} reveal">
          {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
          {%- if section.settings.heading != blank -%}<h2>{{ section.settings.heading }}</h2>{%- endif -%}
          {%- if section.settings.subheading != blank -%}<p class="section__subheading">{{ section.settings.subheading }}</p>{%- endif -%}
        </div>
      {%- endif -%}

      {%- assign cred_blocks = section.blocks | where: 'type', 'credential' -%}
      {%- if cred_blocks.size > 0 -%}
        <div class="grid grid--{{ cols }} mobile-2">
          {%- for block in cred_blocks -%}
            <div class="credential reveal" {{ block.shopify_attributes }}>
              {%- if block.settings.icon != blank -%}
                <span class="credential__icon">{%- render 'icon', name: block.settings.icon, size: 22 -%}</span>
              {%- endif -%}
              <div>
                <h3 class="credential__title">{{ block.settings.title }}</h3>
                {%- if block.settings.text != blank -%}<p class="credential__text">{{ block.settings.text }}</p>{%- endif -%}
              </div>
            </div>
          {%- endfor -%}
        </div>
      {%- endif -%}

      {%- assign logo_blocks = section.blocks | where: 'type', 'logo' -%}
      {%- if logo_blocks.size > 0 -%}
        <div class="logos reveal" style="margin-top: var(--space-48);">
          {%- for block in logo_blocks -%}
            {%- if block.settings.image != blank -%}
              <img src="{{ block.settings.image | image_url: width: 240 }}" alt="{{ block.settings.alt | escape }}" loading="lazy" width="120" {{ block.shopify_attributes }}>
            {%- endif -%}
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Credentials & trust",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Why Families Trust Us" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Evidence-based care with warmth, attunement, and clinical depth" },
    { "type": "text", "id": "subheading", "label": "Subheading" },
    { "type": "select", "id": "text_align", "label": "Header alignment", "options": [
      { "value": "left", "label": "Left" }, { "value": "center", "label": "Center" }
    ], "default": "center" },
    { "type": "select", "id": "columns", "label": "Columns (desktop)", "options": [
      { "value": "2", "label": "2" }, { "value": "3", "label": "3" }, { "value": "4", "label": "4" }
    ], "default": "3" },
    { "type": "header", "content": "Appearance" },
    { "type": "select", "id": "bg_scheme", "label": "Background", "options": [
      { "value": "default", "label": "Page background" }, { "value": "sand", "label": "Sand" },
      { "value": "surface", "label": "White" }, { "value": "navy", "label": "Navy" }
    ], "default": "surface" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 80 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 80 }
  ],
  "blocks": [
    { "type": "credential", "name": "Credential", "settings": [
      { "type": "select", "id": "icon", "label": "Icon", "options": [
        { "value": "award", "label": "Award" }, { "value": "shield", "label": "Shield" },
        { "value": "check", "label": "Check" }, { "value": "heart", "label": "Heart" },
        { "value": "book", "label": "Book" }, { "value": "users", "label": "Users" },
        { "value": "compass", "label": "Compass" }, { "value": "star", "label": "Star" }
      ], "default": "award" },
      { "type": "text", "id": "title", "label": "Title", "default": "Licensed & Credentialed" },
      { "type": "text", "id": "text", "label": "Text", "default": "PsyD, LPCMH, NCC - care delivered by a practicing licensed psychologist." }
    ]},
    { "type": "logo", "name": "Affiliation logo", "settings": [
      { "type": "image_picker", "id": "image", "label": "Logo" },
      { "type": "text", "id": "alt", "label": "Alt text" }
    ]}
  ],
  "max_blocks": 16,
  "presets": [{
    "name": "Credentials & trust",
    "blocks": [
      { "type": "credential", "settings": { "icon": "award", "title": "Licensed & Credentialed", "text": "Care delivered by a practicing licensed psychologist." } },
      { "type": "credential", "settings": { "icon": "shield", "title": "Trauma-Informed", "text": "Calm, regulated, and grounded in nervous-system-aware practice." } },
      { "type": "credential", "settings": { "icon": "compass", "title": "Diagnostic Clarity", "text": "Thorough psychological evaluation to guide next steps." } }
    ]
  }]
}
{% endschema %}
