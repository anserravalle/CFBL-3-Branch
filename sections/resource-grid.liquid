{%- comment -%}
  Resource grid — curated links to pages, downloads, or external resources.
  Each resource is a block (image/icon + title + description + link).
{%- endcomment -%}
{%- liquid
  assign bg = section.settings.bg_scheme
  assign cols = section.settings.columns
-%}
<section class="section bg--{{ bg }}"
  style="--section-pt: {{ section.settings.padding_top }}px; --section-pb: {{ section.settings.padding_bottom }}px;">
  <div class="page-width">
    <div class="section__inner">
      {%- if section.settings.heading != blank or section.settings.eyebrow != blank -%}
        <div class="section__header {% if section.settings.text_align == 'center' %}is-center{% endif %} reveal">
          {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
          {%- if section.settings.heading != blank -%}<h2>{{ section.settings.heading }}</h2>{%- endif -%}
          {%- if section.settings.subheading != blank -%}<p class="section__subheading">{{ section.settings.subheading }}</p>{%- endif -%}
        </div>
      {%- endif -%}

      <div class="grid grid--{{ cols }} mobile-2">
        {%- for block in section.blocks -%}
          {%- assign tag = 'div' -%}
          {%- if block.settings.link != blank -%}{%- assign tag = 'a' -%}{%- endif -%}
          <{{ tag }} {% if tag == 'a' %}href="{{ block.settings.link }}"{% endif %} class="card{% if tag == 'a' %} is-linked{% endif %}" style="{% if tag == 'a' %}text-decoration:none;{% endif %}" {{ block.shopify_attributes }}>
            {%- if block.settings.image != blank -%}
              <div class="card__media">{%- render 'responsive-image', image: block.settings.image, alt: block.settings.title, ratio: '3-2', sizes: '(min-width:990px) 340px, 100vw', widths: '300,450,600' -%}</div>
            {%- elsif block.settings.icon != blank -%}
              <span class="card__icon">{%- render 'icon', name: block.settings.icon, size: 24 -%}</span>
            {%- endif -%}
            <h3 class="card__title">{{ block.settings.title }}</h3>
            {%- if block.settings.description != blank -%}<p class="card__body">{{ block.settings.description }}</p>{%- endif -%}
            {%- if block.settings.link != blank -%}<span class="card__cta btn btn--tertiary" style="padding-inline:0;">{{ block.settings.link_label | default: 'Open' }} <span aria-hidden="true">&rarr;</span></span>{%- endif -%}
          </{{ tag }}>
        {%- endfor -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Resource grid",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Helpful Resources" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Tools & Information" },
    { "type": "text", "id": "subheading", "label": "Subheading" },
    { "type": "select", "id": "text_align", "label": "Header alignment", "options": [
      { "value": "left", "label": "Left" }, { "value": "center", "label": "Center" }
    ], "default": "center" },
    { "type": "select", "id": "columns", "label": "Columns (desktop)", "options": [
      { "value": "2", "label": "2" }, { "value": "3", "label": "3" }, { "value": "4", "label": "4" }
    ], "default": "3" },
    { "type": "header", "content": "Appearance" },
    { "type": "select", "id": "bg_scheme", "label": "Background", "options": [
      { "value": "default", "label": "Page background" }, { "value": "sand", "label": "Sand" }, { "value": "surface", "label": "White" }
    ], "default": "default" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 80 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 80 }
  ],
  "blocks": [
    { "type": "resource", "name": "Resource", "settings": [
      { "type": "image_picker", "id": "image", "label": "Image (optional)" },
      { "type": "select", "id": "icon", "label": "Icon (if no image)", "options": [
        { "value": "book", "label": "Book" }, { "value": "compass", "label": "Compass" },
        { "value": "calendar", "label": "Calendar" }, { "value": "heart", "label": "Heart" },
        { "value": "users", "label": "Users" }, { "value": "shield", "label": "Shield" }
      ], "default": "book" },
      { "type": "text", "id": "title", "label": "Title", "default": "Resource title" },
      { "type": "text", "id": "description", "label": "Description" },
      { "type": "text", "id": "link_label", "label": "Link label", "default": "Open" },
      { "type": "url", "id": "link", "label": "Link" }
    ]}
  ],
  "max_blocks": 12,
  "presets": [{ "name": "Resource grid", "blocks": [{ "type": "resource" }, { "type": "resource" }, { "type": "resource" }] }]
}
{% endschema %}
