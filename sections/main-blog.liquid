{%- comment -%} Main blog — article listing with pagination. {%- endcomment -%}
{%- paginate blog.articles by section.settings.per_page -%}
<div class="section bg--default" style="--section-pt: 72px; --section-pb: 80px;">
  <div class="page-width">
    <div class="section__inner">
      {%- if section.settings.show_title or section.settings.subheading != blank or current_tags -%}
        <header class="section__header is-center reveal">
          {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
          {%- if current_tags -%}
            {%- comment -%} Tag-filtered view (e.g. a "Make It Make Sense" theme) {%- endcomment -%}
            {%- if section.settings.show_title -%}<h1>{{ blog.title }}: {{ current_tags | join: ', ' }}</h1>{%- else -%}<h2>{{ current_tags | join: ', ' }}</h2>{%- endif -%}
            <p class="section__subheading"><a href="{{ blog.url }}">&larr; All of {{ blog.title }}</a></p>
          {%- elsif section.settings.show_title -%}
            <h1>{{ blog.title }}</h1>
            {%- if section.settings.subheading != blank -%}<p class="section__subheading">{{ section.settings.subheading }}</p>{%- endif -%}
          {%- elsif section.settings.subheading != blank -%}
            <p class="section__subheading">{{ section.settings.subheading }}</p>
          {%- endif -%}
        </header>
      {%- endif -%}

      {%- if blog.articles.size > 0 -%}
        <div class="grid grid--3">
          {%- for article in blog.articles -%}
            <article class="article-card reveal">
              {%- if article.image -%}
                <a href="{{ article.url }}" tabindex="-1" aria-hidden="true">{%- render 'responsive-image', image: article.image, alt: article.image.alt | default: article.title, ratio: '3-2', sizes: '(min-width:990px) 380px, 100vw', widths: '320,480,640,800' -%}</a>
              {%- endif -%}
              <div class="article-card__body">
                <p class="article-card__meta"><time datetime="{{ article.published_at | date: '%Y-%m-%d' }}">{{ article.published_at | date: '%b %-d, %Y' }}</time>{% if article.tags.size > 0 %} &middot; {{ article.tags.first }}{% endif %}</p>
                <h2 class="article-card__title" style="font-size:var(--fs-lg);"><a href="{{ article.url }}">{{ article.title }}</a></h2>
                <p class="article-card__excerpt">{{ article.excerpt_or_content | strip_html | truncatewords: 24 }}</p>
                <p class="article-card__cta">{%- render 'button', label: 'Read more', href: article.url, style: 'tertiary', aria: 'Read more: ' | append: article.title -%}</p>
              </div>
            </article>
          {%- endfor -%}
        </div>

        {%- if paginate.pages > 1 -%}
          <nav class="pagination" aria-label="Pagination" role="navigation">
            {%- if paginate.previous -%}<a href="{{ paginate.previous.url }}" aria-label="Previous page">&larr;</a>{%- endif -%}
            {%- for part in paginate.parts -%}
              {%- if part.is_link -%}<a href="{{ part.url }}" aria-label="Page {{ part.title }}">{{ part.title }}</a>
              {%- else -%}<span {% if part.title == paginate.current_page %}aria-current="page"{% endif %}>{{ part.title }}</span>{%- endif -%}
            {%- endfor -%}
            {%- if paginate.next -%}<a href="{{ paginate.next.url }}" aria-label="Next page">&rarr;</a>{%- endif -%}
          </nav>
        {%- endif -%}
      {%- else -%}
        <p class="section__subheading" style="text-align:center;">No posts yet. Check back soon.</p>
      {%- endif -%}
    </div>
  </div>
</div>
{%- endpaginate -%}

{% schema %}
{
  "name": "Blog posts",
  "settings": [
    { "type": "checkbox", "id": "show_title", "label": "Show blog title (H1)", "default": true, "info": "Turn off when another section above provides the page H1." },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Resources" },
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "Grounded, research-informed writing on therapy, evaluation, and care." },
    { "type": "range", "id": "per_page", "label": "Posts per page", "min": 6, "max": 24, "step": 3, "default": 9 }
  ]
}
{% endschema %}
