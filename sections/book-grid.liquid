{%- comment -%}
  Book grid - a shelf of books. Each block is a cover that links to the book's
  own page, with title, subtitle, and an optional status badge. Used full on the
  Books page and as an inline preview (with a "see all" link) on MUSA.
{%- endcomment -%}
{%- liquid
  assign bg = section.settings.bg_scheme
  assign cols = section.settings.columns
-%}
<section class="section bg--{{ bg }}"
  style="--section-pt: {{ section.settings.padding_top }}px; --section-pb: {{ section.settings.padding_bottom }}px;">
  <div class="page-width">
    {%- if section.settings.heading != blank or section.settings.eyebrow != blank -%}
      <div class="section__header {% if section.settings.text_align == 'center' %}is-center{% endif %} reveal">
        {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
        {%- if section.settings.heading != blank -%}<h2>{{ section.settings.heading }}</h2>{%- endif -%}
        {%- if section.settings.subheading != blank -%}<p class="section__subheading">{{ section.settings.subheading }}</p>{%- endif -%}
      </div>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <div class="book-grid book-grid--{{ cols }}">
        {%- for block in section.blocks -%}
          {%- liquid
            assign has_link = false
            if block.settings.link != blank
              assign has_link = true
            endif
          -%}
          <article class="book-card reveal" {{ block.shopify_attributes }}>
            {%- if has_link -%}<a class="book-card__link" href="{{ block.settings.link }}" aria-label="{{ block.settings.title | escape }}">{%- endif -%}
              <figure class="book-card__cover {% if block.settings.cover_frame %}is-framed{% endif %}"
                {% if block.settings.frame_color != blank %}style="--frame-color: {{ block.settings.frame_color }};"{% endif %}>
                {%- if block.settings.cover != blank -%}
                  {%- render 'responsive-image', image: block.settings.cover, alt: block.settings.title, ratio: '2-3', sizes: '(min-width:990px) 30vw, 80vw', widths: '300,400,520,640' -%}
                {%- else -%}
                  <div class="media media--2-3">{{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}</div>
                {%- endif -%}
                {%- if block.settings.status != blank -%}<span class="book-card__badge">{{ block.settings.status }}</span>{%- endif -%}
              </figure>
            {%- if has_link -%}</a>{%- endif -%}
            <div class="book-card__body">
              {%- if block.settings.title != blank -%}<h3 class="book-card__title">{{ block.settings.title }}</h3>{%- endif -%}
              {%- if block.settings.subtitle != blank -%}<p class="book-card__subtitle">{{ block.settings.subtitle }}</p>{%- endif -%}
              {%- if block.settings.blurb != blank -%}<p class="book-card__blurb">{{ block.settings.blurb }}</p>{%- endif -%}
              {%- if has_link -%}
                <p class="book-card__cta"><a href="{{ block.settings.link }}">{{ block.settings.link_label | default: 'Read more' }}</a></p>
              {%- endif -%}
            </div>
          </article>
        {%- endfor -%}
      </div>
    {%- else -%}
      <p class="section__subheading reveal">Add a book in this section's settings.</p>
    {%- endif -%}

    {%- if section.settings.footer_label != blank and section.settings.footer_link != blank -%}
      <div class="section__footer is-center reveal" style="margin-top:var(--space-40);">
        {%- render 'button', label: section.settings.footer_label, href: section.settings.footer_link, style: 'secondary' -%}
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Book grid",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Books" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "The Books" },
    { "type": "text", "id": "subheading", "label": "Subheading" },
    { "type": "select", "id": "text_align", "label": "Header alignment", "options": [
      { "value": "left", "label": "Left" }, { "value": "center", "label": "Center" }
    ], "default": "left" },
    { "type": "select", "id": "columns", "label": "Columns", "options": [
      { "value": "2", "label": "2" }, { "value": "3", "label": "3" }, { "value": "4", "label": "4" }
    ], "default": "3" },
    { "type": "header", "content": "See all link (for previews)" },
    { "type": "text", "id": "footer_label", "label": "Footer button label" },
    { "type": "url", "id": "footer_link", "label": "Footer button link" },
    { "type": "header", "content": "Appearance" },
    { "type": "select", "id": "bg_scheme", "label": "Background", "options": [
      { "value": "default", "label": "Page background" }, { "value": "sand", "label": "Sand" }, { "value": "sage", "label": "Sage" }, { "value": "surface", "label": "White" }, { "value": "navy", "label": "Navy" }
    ], "default": "default" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 80 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 80 }
  ],
  "blocks": [
    { "type": "book", "name": "Book", "settings": [
      { "type": "image_picker", "id": "cover", "label": "Cover image" },
      { "type": "text", "id": "title", "label": "Title", "default": "The Stories We Told" },
      { "type": "text", "id": "subtitle", "label": "Subtitle", "default": "The Dance of a Codependent and a Compulsive Liar" },
      { "type": "textarea", "id": "blurb", "label": "Short blurb" },
      { "type": "text", "id": "status", "label": "Status badge", "info": "e.g. Coming soon, Available now. Leave blank to hide." },
      { "type": "checkbox", "id": "cover_frame", "label": "Show offset frame behind cover", "default": true },
      { "type": "color", "id": "frame_color", "label": "Frame color (leave blank to match brand)" },
      { "type": "url", "id": "link", "label": "Link to the book's page" },
      { "type": "text", "id": "link_label", "label": "Link label", "default": "Read more" }
    ]}
  ],
  "max_blocks": 24,
  "presets": [{ "name": "Book grid", "blocks": [{ "type": "book" }] }]
}
{% endschema %}
