{%- comment -%}
  Text + Image - two-column editorial block. Image side, ratio, alignment,
  colors, padding, mobile stacking, eyebrow, body and two CTAs all editable.
{%- endcomment -%}
{%- liquid
  assign bg = section.settings.bg_scheme
  assign image_side = section.settings.image_position
  assign stack_class = 'stack-image-first'
  if section.settings.mobile_stack == 'text'
    assign stack_class = 'stack-text-first'
  endif
-%}
<section class="section text-image bg--{{ bg }} {{ stack_class }}"
  style="--section-pt: {{ section.settings.padding_top }}px; --section-pb: {{ section.settings.padding_bottom }}px;">
  <div class="page-width">
    <div class="text-image__grid text-image--image-{{ image_side }}">
      {%- if section.settings.image != blank -%}
        <div class="text-image__media reveal">
          {%- render 'responsive-image',
            image: section.settings.image,
            alt: section.settings.image_alt,
            ratio: section.settings.image_ratio,
            sizes: '(min-width: 990px) 48vw, 100vw',
            widths: '480, 640, 800, 1000, 1300' -%}
        </div>
      {%- endif -%}
      <div class="text-image__content reveal" style="text-align: {{ section.settings.text_align }};">
        {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
        {%- if section.settings.heading != blank -%}<h2>{{ section.settings.heading }}</h2>{%- endif -%}
        {%- if section.settings.body != blank -%}<div class="rte">{{ section.settings.body }}</div>{%- endif -%}
        {%- if section.settings.phone != blank or section.settings.email != blank -%}
          <ul class="person-contact"{% if section.settings.text_align == 'center' %} style="justify-content:center;"{% endif %}>
            {%- if section.settings.phone != blank -%}
              <li><a href="tel:{{ section.settings.phone | replace: ' ', '' | replace: '(', '' | replace: ')', '' | replace: '-', '' }}">{%- render 'icon', name: 'phone', size: 15 -%} {{ section.settings.phone }}</a></li>
            {%- endif -%}
            {%- if section.settings.email != blank -%}
              <li><a href="mailto:{{ section.settings.email }}">{%- render 'icon', name: 'mail', size: 15 -%} {{ section.settings.email }}</a></li>
            {%- endif -%}
          </ul>
        {%- endif -%}
        {%- if section.settings.primary_label != blank or section.settings.secondary_label != blank -%}
          <div class="btn-row {% if section.settings.text_align == 'center' %}is-center{% endif %}">
            {%- render 'button', label: section.settings.primary_label, href: section.settings.primary_link, style: 'primary' -%}
            {%- render 'button', label: section.settings.secondary_label, href: section.settings.secondary_link, style: 'tertiary' -%}
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Text with image",
  "tag": "section",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "text", "id": "image_alt", "label": "Image alt text" },
    { "type": "select", "id": "image_ratio", "label": "Image ratio", "options": [
      { "value": "4-3", "label": "4:3" }, { "value": "1-1", "label": "Square" },
      { "value": "3-2", "label": "3:2" }, { "value": "16-9", "label": "16:9" }
    ], "default": "4-3" },
    { "type": "select", "id": "image_position", "label": "Image position (desktop)", "options": [
      { "value": "left", "label": "Left" }, { "value": "right", "label": "Right" }
    ], "default": "left" },
    { "type": "select", "id": "mobile_stack", "label": "Mobile stacking", "options": [
      { "value": "image", "label": "Image first" }, { "value": "text", "label": "Text first" }
    ], "default": "image" },
    { "type": "header", "content": "Content" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "About Us" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Care that honors the complexity of the person, not just the symptom" },
    { "type": "richtext", "id": "body", "label": "Body", "default": "<p>Our approach to care is relational, clinically grounded, and informed by a holistic understanding of development. We integrate evidence-based practice with thoughtful conceptualization to support healing, diagnostic clarity, and sustainable growth.</p>" },
    { "type": "select", "id": "text_align", "label": "Text alignment", "options": [
      { "value": "left", "label": "Left" }, { "value": "center", "label": "Center" }
    ], "default": "left" },
    { "type": "header", "content": "Contact (optional - e.g. team bios)" },
    { "type": "text", "id": "phone", "label": "Phone" },
    { "type": "text", "id": "email", "label": "Email" },
    { "type": "header", "content": "Buttons" },
    { "type": "text", "id": "primary_label", "label": "Primary button label", "default": "Learn About Our Practice" },
    { "type": "url", "id": "primary_link", "label": "Primary button link" },
    { "type": "text", "id": "secondary_label", "label": "Secondary button label" },
    { "type": "url", "id": "secondary_link", "label": "Secondary button link" },
    { "type": "header", "content": "Appearance" },
    { "type": "select", "id": "bg_scheme", "label": "Background", "options": [
      { "value": "default", "label": "Page background" }, { "value": "sand", "label": "Sand" },
      { "value": "surface", "label": "White" }, { "value": "navy", "label": "Navy" },
      { "value": "terracotta", "label": "Terracotta tint" }
    ], "default": "sand" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 80 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 80 }
  ],
  "presets": [{ "name": "Text with image" }]
}
{% endschema %}
