{%- comment -%}
  Responsive image snippet
  Renders a Shopify image with srcset, sizes, focal-point object-position,
  lazy-loading, and async decoding. Falls back to a placeholder when no image.

  Accepts:
    image            {Object}  Shopify image object (required for real image)
    alt              {String}  Alt text (falls back to image.alt)
    sizes            {String}  sizes attribute (default responsive)
    widths           {String}  comma list for srcset (default sensible set)
    ratio            {String}  aspect-ratio css class suffix: 1-1, 3-2, 4-3, 16-9, 21-9
    class            {String}  extra class(es) on the wrapping .media
    loading          {String}  'eager' | 'lazy' (default lazy)
    fetchpriority    {String}  'high' | 'auto' (default auto)
    placeholder      {String}  Shopify placeholder svg name when no image
    figure           {Boolean} wrap in <figure>; caption optional
{%- endcomment -%}

{%- liquid
  assign img = image
  assign alt_text = alt | default: image.alt | escape
  assign img_sizes = sizes | default: '(min-width: 990px) 50vw, 100vw'
  assign img_widths = widths | default: '320, 480, 640, 768, 960, 1200, 1600, 2000'
  assign ratio_class = ''
  if ratio != blank
    assign ratio_class = 'media--' | append: ratio
  endif
  assign load = loading | default: 'lazy'
  assign fp = fetchpriority | default: 'auto'
-%}

<div class="media {{ ratio_class }} {{ class }}">
  {%- if img != blank -%}
    {%- if img.presentation.focal_point -%}
      {%- assign object_pos = img.presentation.focal_point -%}
    {%- endif -%}
    {{
      img
      | image_url: width: 2000
      | image_tag:
        loading: load,
        fetchpriority: fp,
        decoding: 'async',
        sizes: img_sizes,
        widths: img_widths,
        alt: alt_text,
        style: object_pos
    }}
  {%- else -%}
    {{ placeholder | default: 'image' | placeholder_svg_tag: 'placeholder-svg' }}
  {%- endif -%}
</div>
