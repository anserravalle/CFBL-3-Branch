{% doc %}
  @prompt
    I want to link a podcast youtube link 
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-podcast-youtube-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    margin: 0 auto;
  }

  .ai-podcast-youtube__container-{{ ai_gen_id }} {
    background-color: {{ block.settings.background_color }};
    border-radius: {{ block.settings.border_radius }}px;
    padding: {{ block.settings.padding }}px;
    width: 100%;
  }

  .ai-podcast-youtube__header-{{ ai_gen_id }} {
    margin-bottom: {{ block.settings.padding | times: 0.75 }}px;
  }

  .ai-podcast-youtube__title-{{ ai_gen_id }} {
    font-size: {{ block.settings.title_size }}px;
    color: {{ block.settings.text_color }};
    margin: 0 0 12px;
    line-height: 1.3;
  }

  .ai-podcast-youtube__description-{{ ai_gen_id }} {
    font-size: {{ block.settings.description_size }}px;
    color: {{ block.settings.text_color }};
    opacity: 0.85;
    line-height: 1.6;
    margin: 0;
  }

  .ai-podcast-youtube__video-wrapper-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    padding-bottom: 56.25%;
    height: 0;
    overflow: hidden;
    border-radius: {{ block.settings.video_border_radius }}px;
    background-color: #000000;
  }

  .ai-podcast-youtube__video-wrapper-{{ ai_gen_id }} iframe {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }

  .ai-podcast-youtube__placeholder-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: #f4f4f4;
    color: #666;
    font-size: 14px;
    text-align: center;
    padding: 20px;
  }

  @media screen and (max-width: 749px) {
    .ai-podcast-youtube__title-{{ ai_gen_id }} {
      font-size: {{ block.settings.title_size | times: 0.85 }}px;
    }

    .ai-podcast-youtube__description-{{ ai_gen_id }} {
      font-size: {{ block.settings.description_size | times: 0.9 }}px;
    }

    .ai-podcast-youtube__container-{{ ai_gen_id }} {
      padding: {{ block.settings.padding | times: 0.75 }}px;
    }
  }
{% endstyle %}

<podcast-youtube-{{ ai_gen_id }}
  class="ai-podcast-youtube-{{ ai_gen_id }}"
  {{ block.shopify_attributes }}
>
  <div class="ai-podcast-youtube__container-{{ ai_gen_id }}">
    {% if block.settings.title != blank or block.settings.description != blank %}
      <div class="ai-podcast-youtube__header-{{ ai_gen_id }}">
        {% if block.settings.title != blank %}
          <h2 class="ai-podcast-youtube__title-{{ ai_gen_id }}">{{ block.settings.title }}</h2>
        {% endif %}
        {% if block.settings.description != blank %}
          <div class="ai-podcast-youtube__description-{{ ai_gen_id }}">{{ block.settings.description }}</div>
        {% endif %}
      </div>
    {% endif %}

    <div class="ai-podcast-youtube__video-wrapper-{{ ai_gen_id }}">
      {% if block.settings.youtube_url != blank %}
        <iframe
          src="https://www.youtube.com/embed/{{ block.settings.youtube_url | split: 'v=' | last | split: '/' | last | split: '&' | first }}?rel=0&modestbranding=1"
          title="{{ block.settings.title | escape }}"
          allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
          allowfullscreen
          loading="lazy"
        ></iframe>
      {% else %}
        <div class="ai-podcast-youtube__placeholder-{{ ai_gen_id }}">
          Next, paste your YouTube podcast link in the settings
        </div>
      {% endif %}
    </div>
  </div>
</podcast-youtube-{{ ai_gen_id }}>

<script>
  (function() {
    class PodcastYoutube{{ai_gen_id}} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        const iframe = this.querySelector('iframe');
        if (iframe) {
          iframe.addEventListener('load', function() {
            console.log('YouTube video loaded');
          });
        }
      }
    }

    customElements.define('podcast-youtube-{{ ai_gen_id }}', PodcastYoutube{{ai_gen_id}});
  })();
</script>

{% schema %}
{
  "name": "Podcast YouTube",
  "settings": [
    {
      "type": "header",
      "content": "YouTube video"
    },
    {
      "type": "url",
      "id": "youtube_url",
      "label": "YouTube URL"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "Latest Podcast Episode"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>Watch our latest conversation on wellness, therapy, and balanced living.</p>"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Desktop width",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "range",
      "id": "padding",
      "label": "Padding",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "Container border radius",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "video_border_radius",
      "label": "Video border radius",
      "min": 0,
      "max": 24,
      "step": 2,
      "unit": "px",
      "default": 8
    },
    {
      "type": "header",
      "content": "Style"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#FBF6F0"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#2A2724"
    },
    {
      "type": "range",
      "id": "title_size",
      "label": "Title size",
      "min": 18,
      "max": 48,
      "step": 2,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "description_size",
      "label": "Description size",
      "min": 14,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 16
    }
  ],
  "presets": [
    {
      "name": "Podcast YouTube"
    }
  ]
}
{% endschema %}
